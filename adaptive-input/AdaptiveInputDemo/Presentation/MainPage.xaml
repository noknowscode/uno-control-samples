<Page x:Class="AdaptiveInputDemo.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:AdaptiveInputDemo.Presentation"
      xmlns:controls="using:AdaptiveInputDemo.Controls"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:ut="using:Uno.Themes"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">

    <Page.Resources>
        <!-- An example row: 52 px, hairline above, icon and the text in DM Mono, what it reads as on the right. -->
        <Style x:Key="ExampleButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="0,1,0,0">
                            <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                              Foreground="{TemplateBinding Foreground}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SurfaceVariantBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="{ThemeResource SurfaceVariantBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExampleIconStyle" TargetType="Path" BasedOn="{StaticResource AdaptiveIconPathStyle}">
            <Setter Property="Stroke" Value="{ThemeResource OnSurfaceBrush}" />
        </Style>
    </Page.Resources>

    <Grid utu:SafeArea.Insets="VisibleBounds,SoftInput">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Light / Dark switch: a sun when Light, a moon when Dark (App.ThemeRoot through SystemThemeHelper). -->
        <ToggleButton x:Name="ThemeToggle"
                      HorizontalAlignment="Right"
                      Margin="0,8,8,0"
                      Style="{StaticResource IconToggleButtonStyle}"
                      AutomationProperties.Name="Dark theme"
                      ToolTipService.ToolTip="Dark theme"
                      Click="OnThemeToggleClick">
            <ut:ControlExtensions.AlternateContent>
                <FontIcon Glyph="&#xE708;" />
            </ut:ControlExtensions.AlternateContent>
            <FontIcon Glyph="&#xE706;" />
        </ToggleButton>

        <!-- Desktop: the field and its picker beside the examples. Phone (below 600 px): the field fills the screen,
             suggestions sit in the bar above the keyboard, and the examples hide. -->
        <Grid Grid.Row="1"
              MaxWidth="1000"
              Padding="{utu:Responsive Narrowest='16,0,16,0', Normal='32,8,32,24'}"
              ColumnSpacing="{utu:Responsive Narrowest=0, Widest=44}"
              RowSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="New task"
                       FontSize="28"
                       FontWeight="SemiBold"
                       CharacterSpacing="-20"
                       Padding="4,0,0,0"
                       Visibility="{utu:Responsive Narrowest=Visible, Normal=Collapsed}" />

            <controls:AdaptiveInputControl x:Name="MainInput"
                                           Grid.Row="1"
                                           Header="{utu:Responsive Narrowest='', Normal='Task details'}"
                                           Value="tomorrow"
                                           SuggestionsPlacement="{utu:Responsive Narrowest=Accessory, Normal=Panel}"
                                           VerticalAlignment="{utu:Responsive Narrowest=Stretch, Normal=Top}" />

            <StackPanel Grid.Row="1" Grid.Column="1"
                        Width="320"
                        Spacing="10"
                        Visibility="{utu:Responsive Narrowest=Collapsed, Widest=Visible}">
                <TextBlock Text="TRY AN EXAMPLE" Style="{StaticResource AdaptiveInputSectionLabelStyle}" />
                <ItemsControl x:Name="ExampleList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:Example">
                            <Button Style="{StaticResource ExampleButtonStyle}" Tag="{x:Bind Text}" Click="OnExampleClick"
                                    AutomationProperties.Name="{x:Bind AutomationName}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="17" Height="17">
                                        <Path Data="{x:Bind Icon}" Style="{StaticResource ExampleIconStyle}" />
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Text}" FontFamily="{StaticResource AdaptiveInputMonoFontFamily}" FontSize="15" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Viewbox Width="14" Height="14">
                                            <Path Data="M5 12h14 M13 18l6 -6 M13 6l6 6" Stroke="{ThemeResource OnSurfaceVariantBrush}" Style="{StaticResource AdaptiveIconPathStyle}" />
                                        </Viewbox>
                                        <TextBlock Text="{x:Bind ReadsAs}" FontSize="13" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
