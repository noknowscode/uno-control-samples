<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-browserwasm;net10.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!--
      The Snackbar source in Controls/Snackbar/ comes from the Uno Toolkit fork and selects WinUI or UWP namespaces
      with #if IS_WINUI. The Uno.Sdk does not define it, so it is set here.
    -->
    <DefineConstants>$(DefineConstants);IS_WINUI</DefineConstants>

    <!-- Display name -->
    <ApplicationTitle>Snackbar</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.unoplatform.snackbar</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Uno Platform</ApplicationPublisher>
    <!-- Package Description -->
    <Description>A Snackbar and SnackbarHost: Confirm, Undo and Attention messages with a countdown that pauses on hover, focus or touch, and a replace hand-off.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Material;
      Toolkit;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

</Project>
