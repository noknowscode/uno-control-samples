<!--
    The palette: the one place this sample's colours live. MaterialToolkitTheme reads it through ColorOverrideSource
    (App.xaml) and generates every role brush from it, so the controls and the page follow it in Light and Dark.
    Uno Platform Studio's Themes tab edits this file.
    Light is the design's palette: paper #FAF7F0, white surface, ink #161514, muted #5E5A52, hairline #E2DCCF,
    control outline #8C8578; the snackbar slip is the inverse surface (ink) with #F6F2EA text and a #F5C542 action.
    Dark keeps that identity on a warm near-black ground: the slip is lifted one step (#2B2925) and keeps the gold action.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="PrimaryColor">#161514</Color>
      <Color x:Key="OnPrimaryColor">#FAF7F0</Color>
      <Color x:Key="PrimaryContainerColor">#F4F0E7</Color>
      <Color x:Key="OnPrimaryContainerColor">#161514</Color>
      <Color x:Key="SecondaryColor">#5E5A52</Color>
      <Color x:Key="OnSecondaryColor">#FFFFFF</Color>
      <Color x:Key="SecondaryContainerColor">#EFE9DC</Color>
      <Color x:Key="OnSecondaryContainerColor">#161514</Color>
      <Color x:Key="TertiaryColor">#7A5A00</Color>
      <Color x:Key="OnTertiaryColor">#FFFFFF</Color>
      <Color x:Key="TertiaryContainerColor">#F5C542</Color>
      <Color x:Key="OnTertiaryContainerColor">#261A00</Color>
      <Color x:Key="ErrorColor">#B3261E</Color>
      <Color x:Key="OnErrorColor">#FFFFFF</Color>
      <Color x:Key="ErrorContainerColor">#F9DEDC</Color>
      <Color x:Key="OnErrorContainerColor">#410E0B</Color>
      <Color x:Key="BackgroundColor">#FAF7F0</Color>
      <Color x:Key="OnBackgroundColor">#161514</Color>
      <Color x:Key="SurfaceColor">#FFFFFF</Color>
      <Color x:Key="OnSurfaceColor">#161514</Color>
      <Color x:Key="SurfaceVariantColor">#F4F0E7</Color>
      <Color x:Key="OnSurfaceVariantColor">#5E5A52</Color>
      <Color x:Key="OutlineColor">#8C8578</Color>
      <Color x:Key="OutlineVariantColor">#E2DCCF</Color>
      <Color x:Key="SurfaceInverseColor">#161514</Color>
      <Color x:Key="OnSurfaceInverseColor">#F6F2EA</Color>
      <Color x:Key="PrimaryInverseColor">#F5C542</Color>
      <Color x:Key="SurfaceTintColor">#161514</Color>
      <Color x:Key="ShadowColor">#1F161514</Color>
      <Color x:Key="PrimaryVariantDarkColor">#000000</Color>
      <Color x:Key="PrimaryVariantLightColor">#F4F0E7</Color>
      <Color x:Key="SecondaryVariantDarkColor">#3F3C36</Color>
      <Color x:Key="SecondaryVariantLightColor">#EFE9DC</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <Color x:Key="PrimaryColor">#F1ECE2</Color>
      <Color x:Key="OnPrimaryColor">#161514</Color>
      <Color x:Key="PrimaryContainerColor">#2A2723</Color>
      <Color x:Key="OnPrimaryContainerColor">#F1ECE2</Color>
      <Color x:Key="SecondaryColor">#B3AC9F</Color>
      <Color x:Key="OnSecondaryColor">#161514</Color>
      <Color x:Key="SecondaryContainerColor">#34312C</Color>
      <Color x:Key="OnSecondaryContainerColor">#F1ECE2</Color>
      <Color x:Key="TertiaryColor">#F5C542</Color>
      <Color x:Key="OnTertiaryColor">#261A00</Color>
      <Color x:Key="TertiaryContainerColor">#5C4300</Color>
      <Color x:Key="OnTertiaryContainerColor">#FFE08F</Color>
      <Color x:Key="ErrorColor">#FFB4AB</Color>
      <Color x:Key="OnErrorColor">#690005</Color>
      <Color x:Key="ErrorContainerColor">#93000A</Color>
      <Color x:Key="OnErrorContainerColor">#FFDAD6</Color>
      <Color x:Key="BackgroundColor">#141311</Color>
      <Color x:Key="OnBackgroundColor">#F1ECE2</Color>
      <Color x:Key="SurfaceColor">#1D1B18</Color>
      <Color x:Key="OnSurfaceColor">#F1ECE2</Color>
      <Color x:Key="SurfaceVariantColor">#2A2723</Color>
      <Color x:Key="OnSurfaceVariantColor">#B3AC9F</Color>
      <Color x:Key="OutlineColor">#8C8578</Color>
      <Color x:Key="OutlineVariantColor">#34312C</Color>
      <Color x:Key="SurfaceInverseColor">#2B2925</Color>
      <Color x:Key="OnSurfaceInverseColor">#F6F2EA</Color>
      <Color x:Key="PrimaryInverseColor">#F5C542</Color>
      <Color x:Key="SurfaceTintColor">#F1ECE2</Color>
      <Color x:Key="ShadowColor">#66000000</Color>
      <Color x:Key="PrimaryVariantDarkColor">#D9D3C7</Color>
      <Color x:Key="PrimaryVariantLightColor">#2A2723</Color>
      <Color x:Key="SecondaryVariantDarkColor">#8C8578</Color>
      <Color x:Key="SecondaryVariantLightColor">#34312C</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
