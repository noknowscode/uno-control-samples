<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Hanken Grotesk (SIL OFL 1.1, Assets/Fonts/OFL-HankenGrotesk.txt) is the UI face from the design. Every Material
    type style derives from DefaultFontFamily. The prototype ships it as a variable font; Skia needs static files, so
    Regular (400), Medium (500) and SemiBold (600) are static instances, and HankenGrotesk-Regular.ttf.manifest maps
    FontWeight to them.
  -->
  <FontFamily x:Key="DefaultFontFamily">ms-appx:///Assets/Fonts/HankenGrotesk-Regular.ttf</FontFamily>

</ResourceDictionary>
