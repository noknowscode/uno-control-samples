<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:SalesHeatmap.Controls">

  <!--
    SalesHeatmapWidget and SalesHeatmapCell default styles. Colours are palette roles (Styles/ColorPaletteOverride.xaml)
    where Material has one; the rest are the control's own tokens below, Light and Dark.
      Background SurfaceBrush (#131D21)   Foreground OnSurfaceBrush (#E8EEF0)   muted OnSurfaceVariantBrush (#93A5AB)
      hairlines OutlineVariantBrush (#24363C)   control outlines OutlineBrush (#567079)   hover SurfaceVariantBrush (#1B282D)
    Type: Bricolage Grotesque for figures and titles, Figtree for text, Spline Sans Mono for labels
    (Styles/MaterialFontsOverride.xaml).
  -->

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <!-- Five steps of one hue (the prototype's ramp, levels 1–5). -->
      <SolidColorBrush x:Key="SalesHeatLevel1Brush" Color="#1E4A56" />
      <SolidColorBrush x:Key="SalesHeatLevel2Brush" Color="#236A80" />
      <SolidColorBrush x:Key="SalesHeatLevel3Brush" Color="#2E8FA8" />
      <SolidColorBrush x:Key="SalesHeatLevel4Brush" Color="#4DB8CE" />
      <SolidColorBrush x:Key="SalesHeatLevel5Brush" Color="#8EE3F0" />
      <SolidColorBrush x:Key="SalesHatchGroundBrush" Color="#152024" />
      <SolidColorBrush x:Key="SalesHatchLineBrush" Color="#3A5058" />
      <SolidColorBrush x:Key="SalesClosedBrush" Color="#3A5058" />
      <SolidColorBrush x:Key="SalesAheadBrush" Color="#33484F" />
      <SolidColorBrush x:Key="SalesHoverRingBrush" Color="#8FA3AA" />
      <SolidColorBrush x:Key="SalesDetailBrush" Color="#18262B" />
      <SolidColorBrush x:Key="SalesDetailBorderBrush" Color="#2C434A" />
      <SolidColorBrush x:Key="SalesBannerBrush" Color="#1C2A2F" />
      <SolidColorBrush x:Key="SalesSkeletonBrush" Color="#1E2C31" />
      <SolidColorBrush x:Key="SalesUpBrush" Color="#7EDCA4" />
      <SolidColorBrush x:Key="SalesDownBrush" Color="#FF9A85" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="SalesHeatLevel1Brush" Color="#CBE9EF" />
      <SolidColorBrush x:Key="SalesHeatLevel2Brush" Color="#97D3DF" />
      <SolidColorBrush x:Key="SalesHeatLevel3Brush" Color="#55B4C9" />
      <SolidColorBrush x:Key="SalesHeatLevel4Brush" Color="#1F8DA6" />
      <SolidColorBrush x:Key="SalesHeatLevel5Brush" Color="#0B5F72" />
      <SolidColorBrush x:Key="SalesHatchGroundBrush" Color="#F1F5F6" />
      <SolidColorBrush x:Key="SalesHatchLineBrush" Color="#B3C4C9" />
      <SolidColorBrush x:Key="SalesClosedBrush" Color="#9AAEB4" />
      <SolidColorBrush x:Key="SalesAheadBrush" Color="#B3C4C9" />
      <SolidColorBrush x:Key="SalesHoverRingBrush" Color="#5D7880" />
      <SolidColorBrush x:Key="SalesDetailBrush" Color="#F0F6F7" />
      <SolidColorBrush x:Key="SalesDetailBorderBrush" Color="#D2E0E3" />
      <SolidColorBrush x:Key="SalesBannerBrush" Color="#E8F1F3" />
      <SolidColorBrush x:Key="SalesSkeletonBrush" Color="#E2EBED" />
      <SolidColorBrush x:Key="SalesUpBrush" Color="#1D7A45" />
      <SolidColorBrush x:Key="SalesDownBrush" Color="#BF3F28" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Text roles. Labels are authored uppercase (CharacterSpacing is a no-op on Skia). -->
  <Style x:Key="SalesHeatmapAxisLabelStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoRegularFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
  </Style>
  <Style x:Key="SalesHeatmapLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SalesHeatmapAxisLabelStyle}">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="SalesHeatmapTinyStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiRegularFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
  </Style>
  <Style x:Key="SalesHeatmapBodyStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiRegularFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
  </Style>
  <Style x:Key="SalesHeatmapFigureStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplaySemiBoldFontFamily}" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
  </Style>

  <!-- Period segment: 13 px medium, 8 px radius inside a 12 px-radius outline; the checked one is an ink plate. -->
  <Style x:Key="SalesSegmentStyle" TargetType="RadioButton">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontFamily" Value="{StaticResource UiMediumFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Hover.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Hover.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Plate.Opacity" Value="1" />
                    <Setter Target="Label.Foreground" Value="{ThemeResource BackgroundBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Hover" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource SurfaceVariantBrush}" Opacity="0" />
            <Border x:Name="Plate" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource OnSurfaceBrush}" Opacity="0" />
            <ContentPresenter x:Name="Label"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SalesOutlineButtonStyle" TargetType="Button">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiMediumFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="Press" />
            </Grid.RenderTransform>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Plate.Background" Value="{ThemeResource SurfaceVariantBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Plate.Background" Value="{ThemeResource SurfaceVariantBrush}" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.12" />
                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.12" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Plate"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A day. Opacity fades over 250 ms (the prototype's .cell transition); the rest switch instantly. -->
  <Style TargetType="controls:SalesHeatmapCell">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:SalesHeatmapCell">
          <Grid x:Name="Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="KindStates">
                <VisualState x:Name="Void">
                  <VisualState.Setters>
                    <Setter Target="Root.Visibility" Value="Collapsed" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Level1"><VisualState.Setters><Setter Target="Fill.Background" Value="{ThemeResource SalesHeatLevel1Brush}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Level2"><VisualState.Setters><Setter Target="Fill.Background" Value="{ThemeResource SalesHeatLevel2Brush}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Level3"><VisualState.Setters><Setter Target="Fill.Background" Value="{ThemeResource SalesHeatLevel3Brush}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Level4"><VisualState.Setters><Setter Target="Fill.Background" Value="{ThemeResource SalesHeatLevel4Brush}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Level5"><VisualState.Setters><Setter Target="Fill.Background" Value="{ThemeResource SalesHeatLevel5Brush}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Closed">
                  <VisualState.Setters>
                    <Setter Target="Fill.BorderBrush" Value="{ThemeResource SalesClosedBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NoData">
                  <VisualState.Setters>
                    <Setter Target="Hatch.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Ahead">
                  <VisualState.Setters>
                    <Setter Target="Fill.BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
                    <Setter Target="AheadDash.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Skeleton">
                  <VisualState.Setters>
                    <Setter Target="Fill.BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="PeriodStates">
                <VisualState x:Name="InPeriod">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Body" Storyboard.TargetProperty="Opacity">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.25" KeySpline="0.25,0.1 0.25,1" Value="1" />
                    </DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="OutOfPeriod">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Body" Storyboard.TargetProperty="Opacity">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.25" KeySpline="0.25,0.1 0.25,1" Value="0.22" />
                    </DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Unselected" />
                <VisualState x:Name="Selected">
                  <VisualState.Setters>
                    <Setter Target="SelectionRing.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="HoverRing.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid x:Name="Body">
              <Border x:Name="Fill" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="1" BorderBrush="Transparent" />
              <Border x:Name="Hatch" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource SalesHatchGroundBrush}" Visibility="Collapsed">
                <Viewbox Stretch="Fill">
                  <Path Width="30" Height="30"
                        Data="M-30,30 L0,0 M-23.6,30 L6.4,0 M-17.2,30 L12.8,0 M-10.8,30 L19.2,0 M-4.4,30 L25.6,0 M2,30 L32,0 M8.4,30 L38.4,0 M14.8,30 L44.8,0 M21.2,30 L51.2,0 M27.6,30 L57.6,0"
                        Stroke="{ThemeResource SalesHatchLineBrush}" StrokeThickness="1.5">
                    <Path.Clip>
                      <RectangleGeometry Rect="0,0,30,30" />
                    </Path.Clip>
                  </Path>
                </Viewbox>
              </Border>
              <Rectangle x:Name="AheadDash"
                         Visibility="Collapsed"
                         RadiusX="{Binding CornerRadius.TopLeft, RelativeSource={RelativeSource TemplatedParent}}"
                         RadiusY="{Binding CornerRadius.TopLeft, RelativeSource={RelativeSource TemplatedParent}}"
                         Stroke="{ThemeResource SalesAheadBrush}" StrokeThickness="1" StrokeDashArray="3,2" />
            </Grid>
            <!-- Hover: a 1 px ring 2 px out. Selected: a 2 px ink ring 2 px out (the card shows through the gap). -->
            <Border x:Name="HoverRing" Margin="-3" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource SalesHoverRingBrush}" Visibility="Collapsed" />
            <Border x:Name="SelectionRing" Margin="-4" CornerRadius="11" BorderThickness="2" BorderBrush="{ThemeResource OnSurfaceBrush}" Visibility="Collapsed" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="controls:SalesHeatmapWidget">
    <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="32" />
    <Setter Property="Padding" Value="22" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:SalesHeatmapWidget">
          <Border x:Name="Card"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="DataStates">
                <VisualState x:Name="Loading">
                  <VisualState.Setters>
                    <Setter Target="DeltaRow.Visibility" Value="Collapsed" />
                    <Setter Target="DeltaSkeleton.Visibility" Value="Visible" />
                    <Setter Target="DateSkeleton.Visibility" Value="Visible" />
                    <Setter Target="RegionsList.Visibility" Value="Collapsed" />
                    <Setter Target="RegionsSkeleton.Visibility" Value="Visible" />
                    <Setter Target="Legend.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Ready" />
                <VisualState x:Name="Empty">
                  <VisualState.Setters>
                    <Setter Target="FilterLabel.Visibility" Value="Visible" />
                    <Setter Target="GridArea.Opacity" Value="0.35" />
                    <Setter Target="EmptyOverlay.Visibility" Value="Visible" />
                    <Setter Target="Legend.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Stale">
                  <VisualState.Setters>
                    <Setter Target="StaleBanner.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="DeltaStates">
                <VisualState x:Name="DeltaUp">
                  <VisualState.Setters>
                    <Setter Target="UpArrow.Visibility" Value="Visible" />
                    <Setter Target="DeltaValue.Foreground" Value="{ThemeResource SalesUpBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DeltaDown">
                  <VisualState.Setters>
                    <Setter Target="DownArrow.Visibility" Value="Visible" />
                    <Setter Target="DeltaValue.Foreground" Value="{ThemeResource SalesDownBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DeltaNone" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="Regular" />
                <VisualState x:Name="Compact">
                  <VisualState.Setters>
                    <Setter Target="Card.Padding" Value="16" />
                    <Setter Target="Card.CornerRadius" Value="24" />
                    <Setter Target="TitleText.FontSize" Value="24" />
                    <Setter Target="SubtitleText.Visibility" Value="Collapsed" />
                    <Setter Target="UpdatedLabel.Visibility" Value="Visible" />
                    <Setter Target="Segments.Visibility" Value="Collapsed" />
                    <Setter Target="CompactSegments.Visibility" Value="Visible" />
                    <Setter Target="TotalValue.FontSize" Value="34" />
                    <Setter Target="Divider.Visibility" Value="Collapsed" />
                    <Setter Target="Legend.Visibility" Value="Collapsed" />
                    <Setter Target="DetailLongDate.Visibility" Value="Collapsed" />
                    <Setter Target="DetailLongLabel.Visibility" Value="Collapsed" />
                    <Setter Target="RegionsLabel.Visibility" Value="Collapsed" />
                    <Setter Target="DetailShortDate.Visibility" Value="Visible" />
                    <Setter Target="DetailVsLabel.Text" Value="vs avg" />
                    <Setter Target="RevenueBlock.(Grid.Row)" Value="3" />
                    <Setter Target="RevenueBlock.(Grid.Column)" Value="0" />
                    <Setter Target="RevenueBlock.(Grid.ColumnSpan)" Value="3" />
                    <Setter Target="GridBlock.(Grid.Row)" Value="4" />
                    <Setter Target="GridBlock.(Grid.RowSpan)" Value="1" />
                    <Setter Target="GridBlock.(Grid.ColumnSpan)" Value="3" />
                    <Setter Target="GridBlock.Margin" Value="0,16,0,0" />
                    <Setter Target="DetailBlock.(Grid.Row)" Value="5" />
                    <Setter Target="DetailBlock.(Grid.Column)" Value="0" />
                    <Setter Target="DetailBlock.(Grid.ColumnSpan)" Value="3" />
                    <Setter Target="RegionsBlock.(Grid.Row)" Value="6" />
                    <Setter Target="RegionsBlock.(Grid.Column)" Value="0" />
                    <Setter Target="RegionsBlock.(Grid.ColumnSpan)" Value="3" />
                    <Setter Target="RegionsBlock.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <!-- Header: title, subtitle or filter, period selector. -->
              <Grid Grid.ColumnSpan="3" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                  <TextBlock x:Name="TitleText"
                             Text="Sales overview"
                             FontFamily="{StaticResource DisplaySemiBoldFontFamily}"
                             FontSize="21"
                             Foreground="{TemplateBinding Foreground}"
                             VerticalAlignment="Bottom" />
                  <TextBlock x:Name="SubtitleText"
                             Text="{TemplateBinding Subtitle}"
                             Style="{StaticResource SalesHeatmapBodyStyle}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}"
                             VerticalAlignment="Bottom"
                             Margin="0,0,0,3"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                  <TextBlock x:Name="FilterLabel" Text="{TemplateBinding FilterText}" Style="{StaticResource SalesHeatmapTinyStyle}" VerticalAlignment="Center" Visibility="Collapsed" />
                  <TextBlock x:Name="UpdatedLabel" Text="{TemplateBinding UpdatedText}" Style="{StaticResource SalesHeatmapTinyStyle}" VerticalAlignment="Center" Visibility="Collapsed" />
                  <Border x:Name="Segments" Padding="4" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource OutlineBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <RadioButton x:Name="PART_Period0" GroupName="SalesPeriod" Style="{StaticResource SalesSegmentStyle}" />
                      <RadioButton x:Name="PART_Period1" GroupName="SalesPeriod" Style="{StaticResource SalesSegmentStyle}" />
                      <RadioButton x:Name="PART_Period2" GroupName="SalesPeriod" Style="{StaticResource SalesSegmentStyle}" />
                      <RadioButton x:Name="PART_Period3" GroupName="SalesPeriod" Style="{StaticResource SalesSegmentStyle}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>

              <!-- Compact: the period selector gets its own full-width row, at 36 px. -->
              <Border x:Name="CompactSegments" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,16,0,0" Padding="4" CornerRadius="12"
                      BorderThickness="1" BorderBrush="{ThemeResource OutlineBrush}" Visibility="Collapsed">
                <Grid ColumnSpacing="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <RadioButton x:Name="PART_CompactPeriod0" GroupName="SalesCompactPeriod" MinHeight="36" Style="{StaticResource SalesSegmentStyle}" />
                  <RadioButton x:Name="PART_CompactPeriod1" Grid.Column="1" GroupName="SalesCompactPeriod" MinHeight="36" Style="{StaticResource SalesSegmentStyle}" />
                  <RadioButton x:Name="PART_CompactPeriod2" Grid.Column="2" GroupName="SalesCompactPeriod" MinHeight="36" Style="{StaticResource SalesSegmentStyle}" />
                  <RadioButton x:Name="PART_CompactPeriod3" Grid.Column="3" GroupName="SalesCompactPeriod" MinHeight="36" Style="{StaticResource SalesSegmentStyle}" />
                </Grid>
              </Border>

              <!-- Stale: the last good grid stays; this says how old it is. Announced politely. -->
              <Border x:Name="StaleBanner" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,18,0,0" Padding="10,6" CornerRadius="8"
                      Background="{ThemeResource SalesBannerBrush}" Visibility="Collapsed">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                    <Path Width="24" Height="24"
                          Data="M12,9 L12,13 M10.363,3.591 L2.257,17.125 A1.914,1.914 0 0 0 3.893,19.996 L20.107,19.996 A1.914,1.914 0 0 0 21.743,17.126 L13.637,3.59 A1.914,1.914 0 0 0 10.363,3.59 Z M12,16 L12.01,16"
                          Stroke="{ThemeResource OnSurfaceBrush}" StrokeThickness="1.75"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Viewbox>
                  <TextBlock Grid.Column="1" Text="{TemplateBinding StaleText}" Style="{StaticResource SalesHeatmapTinyStyle}"
                             Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"
                             AutomationProperties.LiveSetting="Polite" />
                  <Button x:Name="PART_RetryButton" Grid.Column="2" Content="Retry" Height="24" Padding="8,0" CornerRadius="6" FontSize="11"
                          Style="{StaticResource SalesOutlineButtonStyle}" AutomationProperties.Name="Retry" />
                </Grid>
              </Border>

              <!-- The grid: 14 weeks x 7 days, built by the control (PART_GridCanvas), focusable for the arrow keys. -->
              <StackPanel x:Name="GridBlock" Grid.Row="3" Grid.RowSpan="3" Margin="0,18,0,0" Spacing="14">
                <ContentControl x:Name="PART_GridHost"
                                IsTabStop="True"
                                UseSystemFocusVisuals="True"
                                FocusVisualPrimaryBrush="{ThemeResource OnSurfaceBrush}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Top">
                  <Grid>
                    <Grid x:Name="GridArea">
                      <Canvas x:Name="PART_GridCanvas" />
                    </Grid>
                    <Canvas IsHitTestVisible="False">
                      <Border x:Name="PART_Tooltip" Padding="10,7" CornerRadius="8" Background="{TemplateBinding Foreground}" Visibility="Collapsed">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{TemplateBinding TooltipDate}" FontFamily="{StaticResource UiSemiBoldFontFamily}" FontSize="12" Foreground="{TemplateBinding Background}" />
                          <TextBlock Text="{TemplateBinding TooltipValue}" FontFamily="{StaticResource UiRegularFontFamily}" FontSize="12" Foreground="{TemplateBinding Background}" />
                        </StackPanel>
                      </Border>
                    </Canvas>
                    <!-- Empty: says so where the data would be. -->
                    <StackPanel x:Name="EmptyOverlay" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                      <TextBlock Text="No sales recorded" FontFamily="{StaticResource UiMediumFontFamily}" FontSize="13" Foreground="{TemplateBinding Foreground}"
                                 HorizontalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                      <Button x:Name="PART_ClearFiltersButton" Content="Clear filters" Height="30" HorizontalAlignment="Center"
                              Style="{StaticResource SalesOutlineButtonStyle}" AutomationProperties.Name="Clear filters" />
                    </StackPanel>
                  </Grid>
                </ContentControl>

                <!-- Legend: the five steps with their thresholds, then the three kinds of missing day. -->
                <StackPanel x:Name="Legend" Orientation="Horizontal" Spacing="16">
                  <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Border Width="24" Height="10" CornerRadius="3" Background="{ThemeResource SalesHeatLevel1Brush}" />
                    <Border Width="24" Height="10" CornerRadius="3" Background="{ThemeResource SalesHeatLevel2Brush}" />
                    <Border Width="24" Height="10" CornerRadius="3" Background="{ThemeResource SalesHeatLevel3Brush}" />
                    <Border Width="24" Height="10" CornerRadius="3" Background="{ThemeResource SalesHeatLevel4Brush}" />
                    <Border Width="24" Height="10" CornerRadius="3" Background="{ThemeResource SalesHeatLevel5Brush}" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{TemplateBinding ScaleLabels}" VerticalAlignment="Center" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="10" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource SalesHeatmapAxisLabelStyle}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Width="12" Height="12" CornerRadius="3" BorderThickness="1" BorderBrush="{ThemeResource SalesClosedBrush}" />
                    <TextBlock Text="Closed" Style="{StaticResource SalesHeatmapTinyStyle}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Width="12" Height="12" CornerRadius="3" Background="{ThemeResource SalesHatchGroundBrush}">
                      <Viewbox Stretch="Fill">
                        <Path Width="30" Height="30"
                              Data="M-30,30 L0,0 M-21,30 L9,0 M-12,30 L18,0 M-3,30 L27,0 M6,30 L36,0 M15,30 L45,0 M24,30 L54,0"
                              Stroke="{ThemeResource SalesHatchLineBrush}" StrokeThickness="3.5">
                          <Path.Clip>
                            <RectangleGeometry Rect="0,0,30,30" />
                          </Path.Clip>
                        </Path>
                      </Viewbox>
                    </Border>
                    <TextBlock Text="No data" Style="{StaticResource SalesHeatmapTinyStyle}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Rectangle Width="12" Height="12" RadiusX="3" RadiusY="3" Stroke="{ThemeResource SalesAheadBrush}" StrokeThickness="1" StrokeDashArray="2,2" />
                    <TextBlock Text="Ahead" Style="{StaticResource SalesHeatmapTinyStyle}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>

              <Border x:Name="Divider" Grid.Row="3" Grid.Column="1" Grid.RowSpan="3" Width="1" Margin="32,18,28,0"
                      Background="{TemplateBinding BorderBrush}" />

              <!-- The period's revenue and change. -->
              <StackPanel x:Name="RevenueBlock" Grid.Row="3" Grid.Column="2" Margin="0,18,0,0" Spacing="6">
                <TextBlock Text="{TemplateBinding PeriodTitle}" Style="{StaticResource SalesHeatmapLabelStyle}" />
                <TextBlock x:Name="TotalValue"
                           Text="{TemplateBinding TotalText}"
                           FontFamily="{StaticResource DisplaySemiBoldFontFamily}"
                           FontSize="38"
                           LineHeight="40"
                           LineStackingStrategy="BlockLineHeight"
                           Foreground="{TemplateBinding Foreground}" />
                <Grid MinHeight="18">
                  <StackPanel x:Name="DeltaRow" Orientation="Horizontal" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Path x:Name="UpArrow" Visibility="Collapsed" Width="9" Height="9" Stretch="Fill" VerticalAlignment="Center"
                            Data="M5,1.5 L9,8 L1,8 Z" Fill="{ThemeResource SalesUpBrush}" />
                      <Path x:Name="DownArrow" Visibility="Collapsed" Width="9" Height="9" Stretch="Fill" VerticalAlignment="Center"
                            Data="M5,8.5 L1,2 L9,2 Z" Fill="{ThemeResource SalesDownBrush}" />
                      <TextBlock x:Name="DeltaValue" Text="{TemplateBinding DeltaText}" FontFamily="{StaticResource UiSemiBoldFontFamily}" FontSize="13"
                                 Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{TemplateBinding DeltaNote}" Style="{StaticResource SalesHeatmapTinyStyle}" VerticalAlignment="Center" />
                  </StackPanel>
                  <Border x:Name="DeltaSkeleton" Width="120" Height="10" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center"
                          Background="{ThemeResource SalesSkeletonBrush}" Visibility="Collapsed" />
                </Grid>
              </StackPanel>

              <!-- The selected day, announced politely when it changes. -->
              <Border x:Name="DetailBlock" Grid.Row="4" Grid.Column="2" Margin="0,16,0,0" Padding="16,12" CornerRadius="14" BorderThickness="1"
                      Background="{ThemeResource SalesDetailBrush}" BorderBrush="{ThemeResource SalesDetailBorderBrush}">
                <StackPanel Spacing="6" AutomationProperties.LiveSetting="Polite">
                  <TextBlock x:Name="DetailLongLabel" Text="SELECTED DAY" Style="{StaticResource SalesHeatmapLabelStyle}" />
                  <Grid>
                    <TextBlock x:Name="DetailLongDate" Text="{TemplateBinding SelectedDateText}" FontFamily="{StaticResource UiSemiBoldFontFamily}" FontSize="16"
                               Foreground="{TemplateBinding Foreground}" />
                    <TextBlock x:Name="DetailShortDate" Text="{TemplateBinding SelectedShortDateText}" Style="{StaticResource SalesHeatmapLabelStyle}" Visibility="Collapsed" />
                    <Border x:Name="DateSkeleton" Width="180" Height="12" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{ThemeResource SalesSkeletonBrush}" Visibility="Collapsed" />
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="22">
                    <StackPanel>
                      <TextBlock Text="{TemplateBinding SelectedRevenueText}" Style="{StaticResource SalesHeatmapFigureStyle}" />
                      <TextBlock Text="Revenue" Style="{StaticResource SalesHeatmapTinyStyle}" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="{TemplateBinding SelectedOrdersText}" Style="{StaticResource SalesHeatmapFigureStyle}" />
                      <TextBlock Text="Orders" Style="{StaticResource SalesHeatmapTinyStyle}" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="{TemplateBinding SelectedVsText}" Style="{StaticResource SalesHeatmapFigureStyle}" />
                      <TextBlock x:Name="DetailVsLabel" Text="vs daily avg" Style="{StaticResource SalesHeatmapTinyStyle}" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Top regions for the period. -->
              <StackPanel x:Name="RegionsBlock" Grid.Row="5" Grid.Column="2" Margin="0,16,0,0" Spacing="6" Opacity="0.9">
                <TextBlock x:Name="RegionsLabel" Text="{TemplateBinding RegionsTitle}" Style="{StaticResource SalesHeatmapLabelStyle}" />
                <ItemsControl x:Name="RegionsList" ItemsSource="{TemplateBinding RegionRows}" IsTabStop="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Height="30" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource OutlineVariantBrush}">
                        <Grid ColumnSpacing="10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="68" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Number}" Style="{StaticResource SalesHeatmapAxisLabelStyle}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource SalesHeatmapBodyStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2" Text="{Binding ValueText}" Style="{StaticResource SalesHeatmapBodyStyle}" VerticalAlignment="Center" />
                          <Grid Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{Binding UpVisibility}">
                              <Path Width="9" Height="9" Stretch="Fill" VerticalAlignment="Center" Data="M5,1.5 L9,8 L1,8 Z" Fill="{ThemeResource SalesUpBrush}" />
                              <TextBlock Text="{Binding DeltaText}" FontFamily="{StaticResource UiSemiBoldFontFamily}" FontSize="12" Foreground="{ThemeResource SalesUpBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{Binding DownVisibility}">
                              <Path Width="9" Height="9" Stretch="Fill" VerticalAlignment="Center" Data="M5,8.5 L1,2 L9,2 Z" Fill="{ThemeResource SalesDownBrush}" />
                              <TextBlock Text="{Binding DeltaText}" FontFamily="{StaticResource UiSemiBoldFontFamily}" FontSize="12" Foreground="{ThemeResource SalesDownBrush}" />
                            </StackPanel>
                          </Grid>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Loading: the rows keep their size. -->
                <StackPanel x:Name="RegionsSkeleton" Visibility="Collapsed">
                  <Border Height="30" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource OutlineVariantBrush}">
                    <Border Width="140" Height="10" CornerRadius="4" HorizontalAlignment="Left" Margin="36,0,0,0" Background="{ThemeResource SalesSkeletonBrush}" />
                  </Border>
                  <Border Height="30" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource OutlineVariantBrush}">
                    <Border Width="120" Height="10" CornerRadius="4" HorizontalAlignment="Left" Margin="36,0,0,0" Background="{ThemeResource SalesSkeletonBrush}" />
                  </Border>
                  <Border Height="30" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource OutlineVariantBrush}">
                    <Border Width="100" Height="10" CornerRadius="4" HorizontalAlignment="Left" Margin="36,0,0,0" Background="{ThemeResource SalesSkeletonBrush}" />
                  </Border>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
