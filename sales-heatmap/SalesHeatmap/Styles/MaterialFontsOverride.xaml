<!--
    Font override (MaterialToolkitTheme FontOverrideSource): Figtree for text, Bricolage Grotesque for titles and
    figures, Spline Sans Mono for labels, as in the prototype. Static TTFs cut from the prototype's variable fonts
    (Skia renders a variable font's default instance only; Bricolage at opsz 24); the #fragment is each file's
    internal family name. Licences: Assets/Fonts/<Family>/OFL.txt.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Uno.Themes: every type-scale family derives from DefaultFontFamily. Skia renders one weight per file, so the
       scales Material sets in Medium point at the Medium file. -->
  <FontFamily x:Key="DefaultFontFamily">ms-appx:///Assets/Fonts/Figtree/Figtree-Regular.ttf#Figtree</FontFamily>
  <FontFamily x:Key="TitleMediumFontFamily">ms-appx:///Assets/Fonts/Figtree/Figtree-Medium.ttf#Figtree Medium</FontFamily>
  <FontFamily x:Key="TitleSmallFontFamily">ms-appx:///Assets/Fonts/Figtree/Figtree-Medium.ttf#Figtree Medium</FontFamily>
  <FontFamily x:Key="LabelLargeFontFamily">ms-appx:///Assets/Fonts/Figtree/Figtree-Medium.ttf#Figtree Medium</FontFamily>
  <FontFamily x:Key="LabelMediumFontFamily">ms-appx:///Assets/Fonts/Figtree/Figtree-Medium.ttf#Figtree Medium</FontFamily>
  <FontFamily x:Key="LabelSmallFontFamily">ms-appx:///Assets/Fonts/Figtree/Figtree-Medium.ttf#Figtree Medium</FontFamily>
  <FontFamily x:Key="LabelExtraSmallFontFamily">ms-appx:///Assets/Fonts/Figtree/Figtree-Medium.ttf#Figtree Medium</FontFamily>

  <!-- The same files under app keys, for templates that need a given weight. -->
  <FontFamily x:Key="UiRegularFontFamily">ms-appx:///Assets/Fonts/Figtree/Figtree-Regular.ttf#Figtree</FontFamily>
  <FontFamily x:Key="UiMediumFontFamily">ms-appx:///Assets/Fonts/Figtree/Figtree-Medium.ttf#Figtree Medium</FontFamily>
  <FontFamily x:Key="UiSemiBoldFontFamily">ms-appx:///Assets/Fonts/Figtree/Figtree-SemiBold.ttf#Figtree SemiBold</FontFamily>
  <FontFamily x:Key="DisplayMediumFontFamily">ms-appx:///Assets/Fonts/BricolageGrotesque/BricolageGrotesque-Medium.ttf#Bricolage Grotesque Medium</FontFamily>
  <FontFamily x:Key="DisplaySemiBoldFontFamily">ms-appx:///Assets/Fonts/BricolageGrotesque/BricolageGrotesque-SemiBold.ttf#Bricolage Grotesque SemiBold</FontFamily>
  <FontFamily x:Key="MonoRegularFontFamily">ms-appx:///Assets/Fonts/SplineSansMono/SplineSansMono-Regular.ttf#Spline Sans Mono</FontFamily>
  <FontFamily x:Key="MonoMediumFontFamily">ms-appx:///Assets/Fonts/SplineSansMono/SplineSansMono-Medium.ttf#Spline Sans Mono Medium</FontFamily>
</ResourceDictionary>
