<!--
    The palette: the one place this sample's colours live. MaterialToolkitTheme reads it through ThemeColors
    (App.xaml); Uno Platform Studio's Themes tab edits this file.

    Default (Dark) is the prototype sheet's palette, exactly:
      Background        #0F1619  page (bg)            Surface           #131D21  card (surface)
      OnSurface         #E8EEF0  ink (ink)            OnSurfaceVariant  #93A5AB  muted (muted)
      OutlineVariant    #24363C  hairlines (line)     Outline           #567079  control outlines (ctl)
      Primary           #63D4E4  accent               SurfaceVariant    #1B282D  hover plate
    The heat ramp, hatching, panels and the up/down colours have no Material role: they are the control's tokens
    in Themes/SalesHeatmap.xaml. Secondary and Tertiary carry the prototype's other accent options (#E8EEF0, #7EDCA4).
    Light keeps the same teal identity on a pale ground. All 33 roles are set in both themes.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="PrimaryColor">#0A7383</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
      <Color x:Key="PrimaryContainerColor">#B9EEF6</Color>
      <Color x:Key="OnPrimaryContainerColor">#001F24</Color>
      <Color x:Key="SecondaryColor">#131D21</Color>
      <Color x:Key="OnSecondaryColor">#FFFFFF</Color>
      <Color x:Key="SecondaryContainerColor">#D7E3E6</Color>
      <Color x:Key="OnSecondaryContainerColor">#131D21</Color>
      <Color x:Key="TertiaryColor">#1D7A45</Color>
      <Color x:Key="OnTertiaryColor">#FFFFFF</Color>
      <Color x:Key="TertiaryContainerColor">#A5F2C1</Color>
      <Color x:Key="OnTertiaryContainerColor">#002110</Color>
      <Color x:Key="ErrorColor">#BF3F28</Color>
      <Color x:Key="OnErrorColor">#FFFFFF</Color>
      <Color x:Key="ErrorContainerColor">#FFDAD3</Color>
      <Color x:Key="OnErrorContainerColor">#3E0500</Color>
      <Color x:Key="BackgroundColor">#EEF3F4</Color>
      <Color x:Key="OnBackgroundColor">#0F1E23</Color>
      <Color x:Key="SurfaceColor">#FFFFFF</Color>
      <Color x:Key="OnSurfaceColor">#0F1E23</Color>
      <Color x:Key="SurfaceVariantColor">#E6EEF0</Color>
      <Color x:Key="OnSurfaceVariantColor">#4E6268</Color>
      <Color x:Key="OutlineColor">#7D9399</Color>
      <Color x:Key="OutlineVariantColor">#D5E0E3</Color>
      <Color x:Key="SurfaceInverseColor">#131D21</Color>
      <Color x:Key="OnSurfaceInverseColor">#E8EEF0</Color>
      <Color x:Key="PrimaryInverseColor">#63D4E4</Color>
      <Color x:Key="SurfaceTintColor">#0A7383</Color>
      <Color x:Key="ShadowColor">#000000</Color>
      <Color x:Key="PrimaryVariantDarkColor">#004F58</Color>
      <Color x:Key="PrimaryVariantLightColor">#B9EEF6</Color>
      <Color x:Key="SecondaryVariantDarkColor">#000000</Color>
      <Color x:Key="SecondaryVariantLightColor">#D7E3E6</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <Color x:Key="PrimaryColor">#63D4E4</Color>
      <Color x:Key="OnPrimaryColor">#00363D</Color>
      <Color x:Key="PrimaryContainerColor">#004F58</Color>
      <Color x:Key="OnPrimaryContainerColor">#9EEFFB</Color>
      <Color x:Key="SecondaryColor">#E8EEF0</Color>
      <Color x:Key="OnSecondaryColor">#131D21</Color>
      <Color x:Key="SecondaryContainerColor">#2C434A</Color>
      <Color x:Key="OnSecondaryContainerColor">#E8EEF0</Color>
      <Color x:Key="TertiaryColor">#7EDCA4</Color>
      <Color x:Key="OnTertiaryColor">#003920</Color>
      <Color x:Key="TertiaryContainerColor">#005231</Color>
      <Color x:Key="OnTertiaryContainerColor">#9AF8BE</Color>
      <Color x:Key="ErrorColor">#FF9A85</Color>
      <Color x:Key="OnErrorColor">#5F1508</Color>
      <Color x:Key="ErrorContainerColor">#7F2A1B</Color>
      <Color x:Key="OnErrorContainerColor">#FFDAD3</Color>
      <Color x:Key="BackgroundColor">#0F1619</Color>
      <Color x:Key="OnBackgroundColor">#E8EEF0</Color>
      <Color x:Key="SurfaceColor">#131D21</Color>
      <Color x:Key="OnSurfaceColor">#E8EEF0</Color>
      <Color x:Key="SurfaceVariantColor">#1B282D</Color>
      <Color x:Key="OnSurfaceVariantColor">#93A5AB</Color>
      <Color x:Key="OutlineColor">#567079</Color>
      <Color x:Key="OutlineVariantColor">#24363C</Color>
      <Color x:Key="SurfaceInverseColor">#E8EEF0</Color>
      <Color x:Key="OnSurfaceInverseColor">#131D21</Color>
      <Color x:Key="PrimaryInverseColor">#006874</Color>
      <Color x:Key="SurfaceTintColor">#63D4E4</Color>
      <Color x:Key="ShadowColor">#000000</Color>
      <Color x:Key="PrimaryVariantDarkColor">#3FB3C4</Color>
      <Color x:Key="PrimaryVariantLightColor">#9EEFFB</Color>
      <Color x:Key="SecondaryVariantDarkColor">#B7C4C8</Color>
      <Color x:Key="SecondaryVariantLightColor">#F4F8F9</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
