<hd:Preview x:Class="ReticleLab.HotDesignPreviews.ReticleCompactRingsPreview"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:hd="using:Uno.UI.HotDesign"
            Width="280"
            Height="104">
  <StackPanel Orientation="Horizontal" Spacing="32" Padding="20" Background="{ThemeResource SurfaceBrush}">
    <ProgressRing Style="{StaticResource ReticleRingCompactStyle}" Width="64" Height="64" IsActive="True" IsIndeterminate="True" />
    <ProgressRing Style="{StaticResource ReticleRingCompactStyle}" Width="40" Height="40" IsActive="True" IsIndeterminate="False" Value="40" />
    <ProgressRing Style="{StaticResource ReticleRingCompactStyle}" Width="24" Height="24" IsActive="False" />
  </StackPanel>
</hd:Preview>
