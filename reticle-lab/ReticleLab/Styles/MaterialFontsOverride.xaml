<!--
    Font override (MaterialToolkitTheme FontOverrideSource): JetBrains Mono, the prototype's one typeface.
    Static TTFs cut from the prototype's variable font (Skia renders a variable font's default instance only);
    the #fragment is each file's internal family name. Licence: Assets/Fonts/JetBrainsMono/OFL.txt.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Uno.Themes: every type-scale family derives from DefaultFontFamily. Skia renders one weight per file, so the
       scales Material sets in Medium point at the Medium file. -->
  <FontFamily x:Key="DefaultFontFamily">ms-appx:///Assets/Fonts/JetBrainsMono/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>
  <FontFamily x:Key="TitleMediumFontFamily">ms-appx:///Assets/Fonts/JetBrainsMono/JetBrainsMono-Medium.ttf#JetBrains Mono Medium</FontFamily>
  <FontFamily x:Key="TitleSmallFontFamily">ms-appx:///Assets/Fonts/JetBrainsMono/JetBrainsMono-Medium.ttf#JetBrains Mono Medium</FontFamily>
  <FontFamily x:Key="LabelLargeFontFamily">ms-appx:///Assets/Fonts/JetBrainsMono/JetBrainsMono-Medium.ttf#JetBrains Mono Medium</FontFamily>
  <FontFamily x:Key="LabelMediumFontFamily">ms-appx:///Assets/Fonts/JetBrainsMono/JetBrainsMono-Medium.ttf#JetBrains Mono Medium</FontFamily>
  <FontFamily x:Key="LabelSmallFontFamily">ms-appx:///Assets/Fonts/JetBrainsMono/JetBrainsMono-Medium.ttf#JetBrains Mono Medium</FontFamily>
  <FontFamily x:Key="LabelExtraSmallFontFamily">ms-appx:///Assets/Fonts/JetBrainsMono/JetBrainsMono-Medium.ttf#JetBrains Mono Medium</FontFamily>

  <!-- The same files under app keys, for templates that need a given weight. -->
  <FontFamily x:Key="MonoLightFontFamily">ms-appx:///Assets/Fonts/JetBrainsMono/JetBrainsMono-Light.ttf#JetBrains Mono Light</FontFamily>
  <FontFamily x:Key="MonoRegularFontFamily">ms-appx:///Assets/Fonts/JetBrainsMono/JetBrainsMono-Regular.ttf#JetBrains Mono</FontFamily>
  <FontFamily x:Key="MonoMediumFontFamily">ms-appx:///Assets/Fonts/JetBrainsMono/JetBrainsMono-Medium.ttf#JetBrains Mono Medium</FontFamily>
</ResourceDictionary>
