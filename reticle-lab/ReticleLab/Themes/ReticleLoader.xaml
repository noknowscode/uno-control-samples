                      <Ellipse Canvas.Left="15" Canvas.Top="38" Width="2" Height="2" Fill="{TemplateBinding Foreground}" Opacity="0.6" />
                      <Ellipse Canvas.Left="301.4" Canvas.Top="15.4" Width="3.2" Height="3.2" Fill="{TemplateBinding Foreground}" />
                      <Ellipse Canvas.Left="301" Canvas.Top="21" Width="4" Height="4" Stroke="{TemplateBinding Foreground}" StrokeThickness="0.8" />
                      <Ellipse Canvas.Left="309.6" Canvas.Top="254.6" Width="2.8" Height="2.8" Fill="{TemplateBinding Foreground}" />
                      <Ellipse Canvas.Left="309.2" Canvas.Top="260.2" Width="3.6" Height="3.6" Stroke="{TemplateBinding Foreground}" StrokeThickness="0.8" />
                      <Ellipse Canvas.Left="14.3" Canvas.Top="270.3" Width="3.4" Height="3.4" Fill="{TemplateBinding Foreground}" />
                      <Ellipse Canvas.Left="21.3" Canvas.Top="270.3" Width="3.4" Height="3.4" Fill="{TemplateBinding Foreground}" />
                      <Ellipse Canvas.Left="28.3" Canvas.Top="270.3" Width="3.4" Height="3.4" Fill="{TemplateBinding Foreground}" Opacity="0.5" />

                      <!-- Percent, phase and telemetry: the HUD's reading order. -->
                      <TextBlock Canvas.Left="253" Canvas.Top="-9" Text="{TemplateBinding PercentText}" FontFamily="{StaticResource MonoLightFontFamily}" FontSize="22" Foreground="{TemplateBinding AccentBrush}" />
                      <TextBlock Canvas.Left="254" Canvas.Top="23.5" Text="{TemplateBinding PhaseText}" FontFamily="{StaticResource MonoRegularFontFamily}" FontSize="7.5" Foreground="{TemplateBinding Foreground}" />
                      <TextBlock Canvas.Left="273" Canvas.Top="264.3" Text="{TemplateBinding Telemetry}" FontFamily="{StaticResource MonoRegularFontFamily}" FontSize="6.5" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    </Canvas>

                    <!-- Determinate arc on r = 104: drawn from Value in code (ReticleLoader.UpdateArc). -->
                    <Path x:Name="PART_ProgressArc" Opacity="0" Stroke="{TemplateBinding AccentBrush}" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <!-- Interrupted: the kept progress in ink at 45%, not in the live accent. -->
                    <Path x:Name="PART_ProgressArcInk" Opacity="0" Stroke="{TemplateBinding Foreground}" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                    <Canvas x:Name="SweepLayer" Width="300" Height="300" Opacity="0">
                      <Canvas.RenderTransform>
                        <RotateTransform x:Name="SweepRotation" CenterX="150" CenterY="150" />
                      </Canvas.RenderTransform>
                      <Path Data="M150,46 A104,104 0 0 1 247.7,114.4" Stroke="{TemplateBinding AccentBrush}" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>

                    <Canvas Width="300" Height="300">
                      <Grid x:Name="PART_Node" Canvas.Left="145.8" Canvas.Top="41.8" Width="8.4" Height="8.4" Opacity="0">
                        <Grid.RenderTransform>
                          <TranslateTransform />
                        </Grid.RenderTransform>
                        <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" />
                        <Ellipse x:Name="NodeAccent" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding AccentBrush}" StrokeThickness="1.6" />
                      </Grid>
                    </Canvas>

                    <Canvas Width="300" Height="300">
                      <Canvas.RenderTransform>
                        <CompositeTransform x:Name="CrossTransform" CenterX="150" CenterY="150" />
                      </Canvas.RenderTransform>
                      <Path Data="M156.4,156.4 L162.7,162.7 M143.6,156.4 L137.3,162.7 M143.6,143.6 L137.3,137.3 M156.4,143.6 L162.7,137.3" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" Opacity="0.95" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>

                    <Canvas Width="300" Height="300">
                      <Ellipse Canvas.Left="147.8" Canvas.Top="147.8" Width="4.4" Height="4.4" Fill="{TemplateBinding Foreground}" Opacity="0.5" />
                      <Ellipse x:Name="CenterDotOn" Canvas.Left="147.8" Canvas.Top="147.8" Width="4.4" Height="4.4" Fill="{TemplateBinding AccentBrush}" Opacity="0" />
                    </Canvas>
                  </Grid>
                </Grid>
              </Viewbox>

              <!-- Status: three step dots, the phase in words (announced politely), a detail line, Resume when interrupted. -->
              <StackPanel Grid.Row="1" Spacing="6" HorizontalAlignment="Center" Visibility="{TemplateBinding StatusVisibility}">
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <Grid Width="7" Height="7">
                      <Ellipse Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" />
                      <Ellipse x:Name="DotFill1" Fill="{TemplateBinding Foreground}" Opacity="0" />
                      <Ellipse x:Name="DotPulse1" Fill="{TemplateBinding Foreground}" Opacity="0" />
                    </Grid>
                    <Grid Width="7" Height="7">
                      <Ellipse Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" />
                      <Ellipse x:Name="DotFill2" Fill="{TemplateBinding Foreground}" Opacity="0" />
                      <Ellipse x:Name="DotPulse2" Fill="{TemplateBinding Foreground}" Opacity="0" />
                    </Grid>
                    <Grid Width="7" Height="7">
                      <Ellipse Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" />
                      <Ellipse x:Name="DotFill3" Fill="{TemplateBinding Foreground}" Opacity="0" />
                      <Ellipse x:Name="DotPulse3" Fill="{TemplateBinding Foreground}" Opacity="0" />
                    </Grid>
                  </StackPanel>
                  <TextBlock Text="{TemplateBinding StatusText}"
                             FontFamily="{StaticResource MonoMediumFontFamily}"
                             FontSize="13"
                             Foreground="{TemplateBinding Foreground}"
                             AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <TextBlock Text="{TemplateBinding Detail}"
                           FontFamily="{StaticResource MonoRegularFontFamily}"
                           FontSize="12"
                           LineHeight="19"
                           MaxWidth="280"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                <Button x:Name="PART_ResumeButton"
                        Content="RESUME"
                        Height="30"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed"
                        Style="{StaticResource ReticleOutlineButtonStyle}"
                        AutomationProperties.Name="Resume" />
              </StackPanel>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

