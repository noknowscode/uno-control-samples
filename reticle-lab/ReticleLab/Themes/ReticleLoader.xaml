                      <SplineDoubleKeyFrame KeyTime="0:0:1.2" KeySpline="0.42,0 0.58,1" Value="1" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DotPulse3" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" BeginTime="0:0:0.4">
