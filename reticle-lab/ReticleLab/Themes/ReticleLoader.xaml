      <Setter.Value>
        <ControlTemplate TargetType="controls:ReticleLoader">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="ReticleStates">
                <VisualState x:Name="Scanning">
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BandARotation" Storyboard.TargetProperty="Angle" RepeatBehavior="Forever">
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                      <LinearDoubleKeyFrame KeyTime="0:0:14" Value="360" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BandBRotation" Storyboard.TargetProperty="Angle" RepeatBehavior="Forever">
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                      <LinearDoubleKeyFrame KeyTime="0:0:9" Value="-360" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SweepRotation" Storyboard.TargetProperty="Angle" RepeatBehavior="Forever">
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                      <SplineDoubleKeyFrame KeyTime="0:0:2.4" KeySpline="0.45,0.05 0.55,0.95" Value="360" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SweepLayer" Storyboard.TargetProperty="Opacity">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.3" KeySpline="0.25,0.1 0.25,1" Value="1" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CrossTransform" Storyboard.TargetProperty="ScaleX">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.48" KeySpline="0.3,0.7 0.2,1" Value="1" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CrossTransform" Storyboard.TargetProperty="ScaleY">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.48" KeySpline="0.3,0.7 0.2,1" Value="1" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CrossTransform" Storyboard.TargetProperty="Rotation">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.48" KeySpline="0.3,0.7 0.2,1" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HudRoot" Storyboard.TargetProperty="Opacity">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.3" KeySpline="0.25,0.1 0.25,1" Value="1" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_ProgressArc" Storyboard.TargetProperty="Opacity">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.3" KeySpline="0.25,0.1 0.25,1" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_Node" Storyboard.TargetProperty="Opacity">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.3" KeySpline="0.25,0.1 0.25,1" Value="1" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_ProgressArcInk" Storyboard.TargetProperty="Opacity">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.3" KeySpline="0.25,0.1 0.25,1" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NodeAccent" Storyboard.TargetProperty="Opacity">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.3" KeySpline="0.25,0.1 0.25,1" Value="1" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CenterDotOn" Storyboard.TargetProperty="Opacity">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.3" KeySpline="0.25,0.1 0.25,1" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DotPulse1" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                      <SplineDoubleKeyFrame KeyTime="0:0:0.6" KeySpline="0.42,0 0.58,1" Value="0.35" />
                      <SplineDoubleKeyFrame KeyTime="0:0:1.2" KeySpline="0.42,0 0.58,1" Value="1" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DotPulse2" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" BeginTime="0:0:0.2">
                      <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
