                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DotPulse2" Storyboard.TargetProperty="Opacity">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.2" KeySpline="0.25,0.1 0.25,1" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DotPulse3" Storyboard.TargetProperty="Opacity">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.2" KeySpline="0.25,0.1 0.25,1" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Interrupted">
                  <VisualState.Setters>
                    <Setter Target="PART_ResumeButton.Visibility" Value="Visible" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BandARotation" Storyboard.TargetProperty="Angle">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.48" KeySpline="0.3,0.7 0.2,1" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BandBRotation" Storyboard.TargetProperty="Angle">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.48" KeySpline="0.3,0.7 0.2,1" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SweepRotation" Storyboard.TargetProperty="Angle">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.48" KeySpline="0.3,0.7 0.2,1" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SweepLayer" Storyboard.TargetProperty="Opacity">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.3" KeySpline="0.25,0.1 0.25,1" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CrossTransform" Storyboard.TargetProperty="ScaleX">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.48" KeySpline="0.3,0.7 0.2,1" Value="1" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CrossTransform" Storyboard.TargetProperty="ScaleY">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.48" KeySpline="0.3,0.7 0.2,1" Value="1" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CrossTransform" Storyboard.TargetProperty="Rotation">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.48" KeySpline="0.3,0.7 0.2,1" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HudRoot" Storyboard.TargetProperty="Opacity">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.3" KeySpline="0.25,0.1 0.25,1" Value="1" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_ProgressArc" Storyboard.TargetProperty="Opacity">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.3" KeySpline="0.25,0.1 0.25,1" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_Node" Storyboard.TargetProperty="Opacity">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.3" KeySpline="0.25,0.1 0.25,1" Value="1" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_ProgressArcInk" Storyboard.TargetProperty="Opacity">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.3" KeySpline="0.25,0.1 0.25,1" Value="0.45" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NodeAccent" Storyboard.TargetProperty="Opacity">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.3" KeySpline="0.25,0.1 0.25,1" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CenterDotOn" Storyboard.TargetProperty="Opacity">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.3" KeySpline="0.25,0.1 0.25,1" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DotPulse1" Storyboard.TargetProperty="Opacity">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.2" KeySpline="0.25,0.1 0.25,1" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DotPulse2" Storyboard.TargetProperty="Opacity">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.2" KeySpline="0.25,0.1 0.25,1" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DotPulse3" Storyboard.TargetProperty="Opacity">
                      <SplineDoubleKeyFrame KeyTime="0:0:0.2" KeySpline="0.25,0.1 0.25,1" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="StepStates">
                <VisualState x:Name="Steps0" />
                <VisualState x:Name="Steps1">
                  <VisualState.Setters>
                    <Setter Target="DotFill1.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Steps2">
                  <VisualState.Setters>
                    <Setter Target="DotFill1.Opacity" Value="1" />
                    <Setter Target="DotFill2.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Steps3">
                  <VisualState.Setters>
                    <Setter Target="DotFill1.Opacity" Value="1" />
                    <Setter Target="DotFill2.Opacity" Value="1" />
                    <Setter Target="DotFill3.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid RowSpacing="14">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <!-- The canvas leaves the labels room to overflow the 300 units, as the SVG does (overflow: visible). -->
              <Viewbox Stretch="Uniform">
                <Grid Width="360" Height="324">
                  <Grid x:Name="HudRoot" Width="300" Height="300" Margin="16,12,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Canvas Width="300" Height="300">
                      <Canvas.RenderTransform>
                        <RotateTransform x:Name="BandARotation" CenterX="150" CenterY="150" />
                      </Canvas.RenderTransform>
                    <Path Data="M27,114.7 A128,128 0 0 1 132.2,23.2" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" Opacity=".85" />
                    <Path Data="M271.7,189.6 A128,128 0 0 1 185.3,273" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" Opacity=".6" StrokeDashArray="2.0,4.0" />
                    <Path Data="M200.2,55.5 L206.8,43.2 M223,71.7 L232.5,61.5 M240.7,93.3 L252.6,85.9 M252.3,118.7 L265.7,114.6 M256.9,146.3 L270.9,145.8 M254.3,174.1 L267.9,177.2 M244.5,200.2 L256.8,206.8 M228.3,223 L238.5,232.5 M206.7,240.7 L214.1,252.6 M181.3,252.3 L185.4,265.7" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" Opacity="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="M207.7,54 L210.3,49.7 M212.6,57.1 L215.4,53 M217.4,60.6 L220.4,56.6 M222,64.2 L225.2,60.4 M230.6,72.2 L234.2,68.7 M234.5,76.5 L238.3,73.2 M238.3,81 L242.2,78 M241.7,85.8 L245.8,82.9 M248,95.7 L252.3,93.3 M250.7,100.9 L255.2,98.7 M253.1,106.2 L257.7,104.3 M255.2,111.7 L259.9,110 M258.7,122.9 L263.5,121.7 M259.9,128.6 L264.9,127.7 M260.9,134.4 L265.9,133.7 M261.6,140.2 L266.6,139.8 M262,152 L267,152 M261.7,157.8 L266.7,158.2 M261.2,163.6 L266.1,164.3 M260.3,169.4 L265.2,170.3 M257.7,180.9 L262.5,182.2 M255.9,186.5 L260.6,188.1 M253.8,192 L258.5,193.8 M251.5,197.3 L256,199.4 M246,207.7 L250.3,210.3 M242.9,212.6 L247,215.4 M239.4,217.4 L243.4,220.4 M235.8,222 L239.6,225.2 M227.8,230.6 L231.3,234.2 M223.5,234.5 L226.8,238.3 M219,238.3 L222,242.2 M214.2,241.7 L217.1,245.8 M204.3,248 L206.7,252.3 M199.1,250.7 L201.3,255.2 M193.8,253.1 L195.7,257.7 M188.3,255.2 L190,259.9 M177.1,258.7 L178.3,263.5 M171.4,259.9 L172.3,264.9 M165.6,260.9 L166.3,265.9" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" Opacity="0.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                    <Canvas Width="300" Height="300">
                      <Canvas.RenderTransform>
                        <RotateTransform x:Name="BandBRotation" CenterX="150" CenterY="150" />
                      </Canvas.RenderTransform>
                    <Path Data="M49.9,212.5 A118,118 0 0 1 43.9,98.3" Stroke="{TemplateBinding Foreground}" StrokeThickness="4" Opacity="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="M49.9,87.5 A118,118 0 0 1 77.4,57" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Opacity=".7" />
                    <Path Data="M83.3,188.5 L78.1,191.5 M81.9,185.9 L76.6,188.7 M80.6,183.3 L75.1,185.9 M79.3,180.6 L73.8,183 M78.2,177.8 L72.6,180 M77.2,175.1 L71.5,177 M76.3,172.3 L70.5,174 M75.5,169.4 L69.7,170.9 M74.8,166.5 L68.9,167.8 M74.2,163.6 L68.3,164.7 M73.7,160.7 L67.8,161.6 M73.4,157.8 L67.4,158.4 M73.2,154.8 L67.2,155.2 M73,151.9 L67,152 M73,148.9 L67,148.8 M73.1,146 L67.1,145.7 M73.3,143 L67.3,142.5 M73.6,140.1 L67.7,139.3 M74.1,137.2 L68.2,136.2 M74.6,134.3 L68.8,133 M75.3,131.4 L69.5,129.9 M76.1,128.5 L70.3,126.8 M76.9,125.7 L71.2,123.8 M77.9,122.9 L72.3,120.8 M79,120.2 L73.5,117.8 M80.2,117.5 L74.8,114.9 M81.5,114.8 L76.2,112.1 M82.9,112.2 L77.7,109.3 M84.4,109.7 L79.3,106.5 M86,107.2 L81,103.8 M87.7,104.7 L82.9,101.2 M89.5,102.4 L84.8,98.7 M91.4,100.1 L86.8,96.2 M93.3,97.9 L88.9,93.8 M95.4,95.7 L91.1,91.5 M97.5,93.7 L93.4,89.3 M99.7,91.7 L95.8,87.2 M102,89.8 L98.2,85.1" Stroke="{TemplateBinding Foreground}" StrokeThickness="0.9" Opacity="0.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                    <Canvas Width="300" Height="300">
                  <Path Data="M14,20 L30,20 L22,33 Z" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3" Opacity="1" StrokeLineJoin="Round" />
                  <Path Data="M231.3,46 L251,20 L298,20" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" Opacity=".8" />
                  <Path Data="M251.1,234.8 L271,259 L306,259" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" Opacity=".7" />
                  <Path Data="M14,150 L30,150 M38,272 L96,272" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" Opacity="0.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                  <Path Data="M270,150 L286,150 M150,274 L150,284" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" Opacity="0.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                  <Path Data="M150,16 L150,26 M96,272 L112,262" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" Opacity="0.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                      <Ellipse Canvas.Left="55.5" Canvas.Top="55.5" Width="189" Height="189" Stroke="{TemplateBinding Foreground}" StrokeThickness="1" Opacity="0.9" />
