<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:ReticleLab.Controls">

  <!--
    ReticleLoader's default style. The design is the prototype's 300-unit SVG, converted to Path/Ellipse on a
    300 x 300 canvas and scaled by a Viewbox (420 px in the prototype's live view, 290 on a phone, 180 in a card).
    Colours are palette roles (Styles/ColorPaletteOverride.xaml):
      Foreground   OnSurfaceBrush         ink: bands, rings, cross, labels
      AccentBrush  PrimaryBrush           sweep, progress arc, node, lock dot, percent
      Background   SurfaceBrush           the ground (and the node's fill)
      BorderBrush  OutlineVariantBrush    the hairline frame
      muted text   OnSurfaceVariantBrush
    Motion (prototype values): bands 14 s and 9 s reverse, linear; sweep 2.4 s cubic-bezier(.45,.05,.55,.95);
    the X closes in 480 ms on cubic-bezier(.3,.7,.2,1); fades 300 ms; status dots pulse 1.2 s, staggered 0.2 s.
    Every state storyboard animates every animated property with From-less keyframes, so Uno's VisualStateManager
    hands each one over from its live value (no snap between states).
  -->

  <Style x:Key="ReticleOutlineButtonStyle" TargetType="Button">
    <Setter Property="Height" Value="36" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontFamily" Value="{StaticResource MonoRegularFontFamily}" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="PressScale" />
            </Grid.RenderTransform>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Plate.Background" Value="{ThemeResource SurfaceVariantBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Plate.Background" Value="{ThemeResource SurfaceVariantBrush}" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.12" />
                    <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.12" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="RootGrid.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Plate"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

