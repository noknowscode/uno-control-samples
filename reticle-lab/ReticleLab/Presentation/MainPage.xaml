<Page x:Class="ReticleLab.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:ReticleLab.Controls"
      xmlns:utu="using:Uno.Toolkit.UI"
      NavigationCacheMode="Required"
      Background="{ThemeResource BackgroundBrush}">

  <!-- A minimal host: the loader, the modes that drive it, the compact ProgressRing sizes and the theme switch. -->
  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Padding="{utu:Responsive Narrowest='16,12', Normal='32,16'}" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="RETICLE LOADER" Style="{StaticResource HudTitleStyle}" VerticalAlignment="Center" />
      <ToggleButton x:Name="ThemeToggle"
                    Grid.Column="1"
                    Content="DARK"
                    Style="{StaticResource HudToggleStyle}"
                    Click="OnThemeToggleClick"
                    AutomationProperties.Name="Dark theme"
                    AutomationProperties.AutomationId="ThemeToggle" />
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Orientation="{utu:Responsive Narrowest=Vertical, Widest=Horizontal}"
                  Spacing="{utu:Responsive Narrowest=24, Widest=40}"
                  Padding="{utu:Responsive Narrowest='16,0,16,24', Normal='32,0,32,32'}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

        <controls:ReticleLoader x:Name="Loader"
                                Width="{utu:Responsive Narrowest=358, Normal=480, Widest=560}"
                                Height="{utu:Responsive Narrowest=440, Normal=560, Widest=640}"
                                State="{x:Bind ViewModel.State, Mode=OneWay}"
                                Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                                Telemetry="{x:Bind ViewModel.Telemetry, Mode=OneWay}"
                                Detail="{x:Bind ViewModel.Detail, Mode=OneWay}"
                                IsMotionReduced="{x:Bind ViewModel.IsMotionReduced}"
                                ResumeCommand="{x:Bind ViewModel.ResumeCommand}"
                                AutomationProperties.Name="Syncing workspace"
                                AutomationProperties.AutomationId="Loader" />

        <StackPanel Width="{utu:Responsive Narrowest=358, Normal=480, Widest=300}" Spacing="22" VerticalAlignment="Center">
          <StackPanel Spacing="10">
            <TextBlock Text="MODE" Style="{StaticResource HudLabelStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <RadioButton Content="SCAN"
                           GroupName="Mode"
                           Style="{StaticResource HudSegmentStyle}"
                           IsChecked="{x:Bind ViewModel.IsScan, Mode=OneWay}"
                           Command="{x:Bind ViewModel.ScanCommand}"
                           AutomationProperties.AutomationId="ScanSegment" />
              <RadioButton Content="LOCK"
                           GroupName="Mode"
                           Style="{StaticResource HudSegmentStyle}"
                           IsChecked="{x:Bind ViewModel.IsLock, Mode=OneWay}"
                           Command="{x:Bind ViewModel.LockCommand}"
                           AutomationProperties.AutomationId="LockSegment" />
              <RadioButton Content="IDLE"
                           GroupName="Mode"
                           Style="{StaticResource HudSegmentStyle}"
                           IsChecked="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                           Command="{x:Bind ViewModel.IdleCommand}"
                           AutomationProperties.AutomationId="IdleSegment" />
            </StackPanel>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Style="{StaticResource ReticleOutlineButtonStyle}"
                    Command="{x:Bind ViewModel.RunAgainCommand}"
                    AutomationProperties.Name="Run again"
                    AutomationProperties.AutomationId="RunAgain">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Viewbox Width="15" Height="15">
                  <Path Data="M20,11 A8.1,8.1 0 0 0 4.5,9 M4,5 L4,9 L8,9 M4,13 A8.1,8.1 0 0 0 19.5,15 M20,19 L20,15 L16,15"
                        Width="24" Height="24"
                        Stroke="{ThemeResource OnSurfaceBrush}" StrokeThickness="1.75"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Viewbox>
                <TextBlock Text="RUN AGAIN" Style="{StaticResource HudButtonLabelStyle}" />
              </StackPanel>
            </Button>
            <Button Content="INTERRUPT"
                    Style="{StaticResource ReticleOutlineButtonStyle}"
                    Command="{x:Bind ViewModel.InterruptCommand}"
                    IsEnabled="{x:Bind ViewModel.CanInterrupt, Mode=OneWay}"
                    AutomationProperties.AutomationId="Interrupt" />
          </StackPanel>

          <Border Height="1" Background="{ThemeResource OutlineVariantBrush}" />

          <StackPanel Spacing="14">
            <TextBlock Text="PROGRESSRING TEMPLATE · SIZES" Style="{StaticResource HudLabelStyle}" />
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="10">
                <Grid Height="64">
                  <ProgressRing Style="{StaticResource ReticleRingCompactStyle}" Width="64" Height="64"
                                Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                                IsIndeterminate="{x:Bind ViewModel.RingIsIndeterminate, Mode=OneWay}"
                                IsActive="{x:Bind ViewModel.RingIsActive, Mode=OneWay}"
                                AutomationProperties.Name="Loader, 64 pixels" />
                </Grid>
                <TextBlock Text="64 PX" Style="{StaticResource HudLabelStyle}" HorizontalAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="10">
                <Grid Height="64">
                  <ProgressRing Style="{StaticResource ReticleRingCompactStyle}" Width="40" Height="40"
                                Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                                IsIndeterminate="{x:Bind ViewModel.RingIsIndeterminate, Mode=OneWay}"
                                IsActive="{x:Bind ViewModel.RingIsActive, Mode=OneWay}"
                                AutomationProperties.Name="Loader, 40 pixels" />
                </Grid>
                <TextBlock Text="40 PX" Style="{StaticResource HudLabelStyle}" HorizontalAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="10">
                <Grid Height="64">
                  <ProgressRing Style="{StaticResource ReticleRingCompactStyle}" Width="24" Height="24"
                                Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                                IsIndeterminate="{x:Bind ViewModel.RingIsIndeterminate, Mode=OneWay}"
                                IsActive="{x:Bind ViewModel.RingIsActive, Mode=OneWay}"
                                AutomationProperties.Name="Loader, 24 pixels" />
                </Grid>
                <TextBlock Text="24 PX" Style="{StaticResource HudLabelStyle}" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
