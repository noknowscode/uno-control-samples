<Application x:Class="PrecisionDial.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utum="using:Uno.Toolkit.UI.Material">
  <!--
    The palette (Styles/ColorPaletteOverride.xaml) and the demo surfaces (Controls/PrecisionDial/Theme/
    PrecisionDialResources.xaml) have Light and Default (dark) values. App.xaml.cs starts the app in Dark, the
    design's default; the header's theme switch changes it at runtime.
  -->

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <utum:MaterialToolkitTheme
          ColorOverrideSource="ms-appx:///Styles/ColorPaletteOverride.xaml"
          FontOverrideSource="ms-appx:///Styles/MaterialFontsOverride.xaml" />
        <!-- The stage's theme brushes and the sheet's fonts -->
        <ResourceDictionary Source="ms-appx:///Controls/PrecisionDial/Theme/PrecisionDialResources.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
