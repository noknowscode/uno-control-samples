<!--
    Barlow for the Material type ramp (the Precision Dial sheet's UI face); static files, one per weight.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="MaterialLightFontFamily">ms-appx:///Assets/Fonts/Barlow-Regular.ttf#Barlow</FontFamily>
  <FontFamily x:Key="MaterialRegularFontFamily">ms-appx:///Assets/Fonts/Barlow-Regular.ttf#Barlow</FontFamily>
  <FontFamily x:Key="MaterialMediumFontFamily">ms-appx:///Assets/Fonts/Barlow-SemiBold.ttf#Barlow SemiBold</FontFamily>
</ResourceDictionary>
