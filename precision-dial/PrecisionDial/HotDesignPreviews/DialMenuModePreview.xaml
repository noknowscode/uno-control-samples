<hd:Preview x:Class="PrecisionDial.HotDesignPreviews.DialMenuModePreview"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:hd="using:Uno.UI.HotDesign"
            xmlns:controls="using:PrecisionDial.Controls"
            Width="300" Height="300">
  <Grid Background="{ThemeResource DialStageBackgroundBrush}">
    <controls:PrecisionDial x:Name="Dial" DialMode="Menu" Width="240" Height="240"
                            AccentBrush="{ThemeResource PrimaryBrush}" AutomationProperties.Name="Mode" />
  </Grid>
</hd:Preview>
