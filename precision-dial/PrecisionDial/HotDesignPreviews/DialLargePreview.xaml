<hd:Preview x:Class="PrecisionDial.HotDesignPreviews.DialLargePreview"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:hd="using:Uno.UI.HotDesign"
            xmlns:controls="using:PrecisionDial.Controls"
            Width="340" Height="340">
  <Grid Background="{ThemeResource DialStageBackgroundBrush}">
    <controls:PrecisionDial Value="85" Minimum="0" Maximum="100" DetentCount="20" Width="280" Height="280"
                            AccentBrush="{ThemeResource PrimaryBrush}" AutomationProperties.Name="Value" />
  </Grid>
</hd:Preview>
