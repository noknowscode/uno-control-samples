<!--
    The palette: the one place this sample's colours live. MaterialToolkitTheme reads it through ColorOverrideSource
    (App.xaml) and generates every role brush from it (PrimaryBrush, OnSurfaceBrush, SurfaceVariantBrush...).
    Uno Platform Studio's Themes tab edits this file. All 33 roles are set in both themes.
    Light is the Control Gallery "Carousel" sheet: paper ground #ECE7DE, card surface #F4EFE7, ink #1D1B18, muted
    #5F594F, hairline #CFC6B8, control outline #857D6E and the rust plate accent #B5552F as Primary.
    Dark keeps the warm paper identity on a charcoal ground.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="PrimaryColor">#B5552F</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
      <Color x:Key="PrimaryContainerColor">#F3DCCF</Color>
      <Color x:Key="OnPrimaryContainerColor">#3D1505</Color>
      <Color x:Key="SecondaryColor">#5F594F</Color>
      <Color x:Key="OnSecondaryColor">#FFFFFF</Color>
      <Color x:Key="SecondaryContainerColor">#E4DACA</Color>
      <Color x:Key="OnSecondaryContainerColor">#1D1B18</Color>
      <Color x:Key="TertiaryColor">#4F5D66</Color>
      <Color x:Key="OnTertiaryColor">#FFFFFF</Color>
      <Color x:Key="TertiaryContainerColor">#D3DEE4</Color>
      <Color x:Key="OnTertiaryContainerColor">#0B1B23</Color>
      <Color x:Key="ErrorColor">#B3261E</Color>
      <Color x:Key="OnErrorColor">#FFFFFF</Color>
      <Color x:Key="ErrorContainerColor">#F9DEDC</Color>
      <Color x:Key="OnErrorContainerColor">#410E0B</Color>
      <Color x:Key="BackgroundColor">#ECE7DE</Color>
      <Color x:Key="OnBackgroundColor">#1D1B18</Color>
      <Color x:Key="SurfaceColor">#F4EFE7</Color>
      <Color x:Key="OnSurfaceColor">#1D1B18</Color>
      <Color x:Key="SurfaceVariantColor">#E4DACA</Color>
      <Color x:Key="OnSurfaceVariantColor">#5F594F</Color>
      <Color x:Key="OutlineColor">#857D6E</Color>
      <Color x:Key="OutlineVariantColor">#CFC6B8</Color>
      <Color x:Key="SurfaceInverseColor">#32302B</Color>
      <Color x:Key="OnSurfaceInverseColor">#F4EFE7</Color>
      <Color x:Key="PrimaryInverseColor">#E08A63</Color>
      <Color x:Key="SurfaceTintColor">#B5552F</Color>
      <Color x:Key="ShadowColor">#33000000</Color>
      <Color x:Key="PrimaryVariantDarkColor">#8C3F23</Color>
      <Color x:Key="PrimaryVariantLightColor">#F3DCCF</Color>
      <Color x:Key="SecondaryVariantDarkColor">#3F3A33</Color>
      <Color x:Key="SecondaryVariantLightColor">#E4DACA</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <Color x:Key="PrimaryColor">#E08A63</Color>
      <Color x:Key="OnPrimaryColor">#3A1608</Color>
      <Color x:Key="PrimaryContainerColor">#7A3A22</Color>
      <Color x:Key="OnPrimaryContainerColor">#F8DCCD</Color>
      <Color x:Key="SecondaryColor">#B8AE9F</Color>
      <Color x:Key="OnSecondaryColor">#2B2620</Color>
      <Color x:Key="SecondaryContainerColor">#3F3A33</Color>
      <Color x:Key="OnSecondaryContainerColor">#EDE6DA</Color>
      <Color x:Key="TertiaryColor">#A9B9C2</Color>
      <Color x:Key="OnTertiaryColor">#17262E</Color>
      <Color x:Key="TertiaryContainerColor">#34424A</Color>
      <Color x:Key="OnTertiaryContainerColor">#D3DEE4</Color>
      <Color x:Key="ErrorColor">#F2B8B5</Color>
      <Color x:Key="OnErrorColor">#601410</Color>
      <Color x:Key="ErrorContainerColor">#8C1D18</Color>
      <Color x:Key="OnErrorContainerColor">#F9DEDC</Color>
      <Color x:Key="BackgroundColor">#1A1815</Color>
      <Color x:Key="OnBackgroundColor">#EDE6DA</Color>
      <Color x:Key="SurfaceColor">#23201C</Color>
      <Color x:Key="OnSurfaceColor">#EDE6DA</Color>
      <Color x:Key="SurfaceVariantColor">#34302A</Color>
      <Color x:Key="OnSurfaceVariantColor">#B8AE9F</Color>
      <Color x:Key="OutlineColor">#8F8676</Color>
      <Color x:Key="OutlineVariantColor">#4A443B</Color>
      <Color x:Key="SurfaceInverseColor">#EDE6DA</Color>
      <Color x:Key="OnSurfaceInverseColor">#32302B</Color>
      <Color x:Key="PrimaryInverseColor">#B5552F</Color>
      <Color x:Key="SurfaceTintColor">#E08A63</Color>
      <Color x:Key="ShadowColor">#66000000</Color>
      <Color x:Key="PrimaryVariantDarkColor">#B5552F</Color>
      <Color x:Key="PrimaryVariantLightColor">#F3DCCF</Color>
      <Color x:Key="SecondaryVariantDarkColor">#2B2620</Color>
      <Color x:Key="SecondaryVariantLightColor">#B8AE9F</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
