<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:Uno.Toolkit.UI">

  <!-- Design tokens from the Control Gallery "Carousel" sheet. Light is the sheet's palette; Dark keeps its warm
       paper identity on a charcoal ground. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="CarouselMatBrush" Color="#F8F4EC" />
      <SolidColorBrush x:Key="CarouselMatLineBrush" Color="#DDD3C3" />
      <SolidColorBrush x:Key="CarouselInkBrush" Color="#1D1B18" />
      <SolidColorBrush x:Key="CarouselMutedBrush" Color="#5F594F" />
      <SolidColorBrush x:Key="CarouselLineBrush" Color="#CFC6B8" />
      <SolidColorBrush x:Key="CarouselControlOutlineBrush" Color="#857D6E" />
      <SolidColorBrush x:Key="CarouselSkeletonBrush" Color="#DDD4C5" />
      <SolidColorBrush x:Key="CarouselPlaceholderBrush" Color="#E4DACA" />
      <SolidColorBrush x:Key="CarouselButtonHoverBrush" Color="#F8F4EC" />
      <SolidColorBrush x:Key="CarouselButtonPressedBrush" Color="#E4DACA" />
      <SolidColorBrush x:Key="CarouselIndicatorActiveBrush" Color="#1D1B18" />
      <SolidColorBrush x:Key="CarouselIndicatorInactiveBrush" Color="#CFC6B8" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="CarouselMatBrush" Color="#2A2722" />
      <SolidColorBrush x:Key="CarouselMatLineBrush" Color="#3B362F" />
      <SolidColorBrush x:Key="CarouselInkBrush" Color="#EDE6DA" />
      <SolidColorBrush x:Key="CarouselMutedBrush" Color="#B8AE9F" />
      <SolidColorBrush x:Key="CarouselLineBrush" Color="#4A443B" />
      <SolidColorBrush x:Key="CarouselControlOutlineBrush" Color="#8F8676" />
      <SolidColorBrush x:Key="CarouselSkeletonBrush" Color="#3A352E" />
      <SolidColorBrush x:Key="CarouselPlaceholderBrush" Color="#34302A" />
      <SolidColorBrush x:Key="CarouselButtonHoverBrush" Color="#2A2722" />
      <SolidColorBrush x:Key="CarouselButtonPressedBrush" Color="#34302A" />
      <SolidColorBrush x:Key="CarouselIndicatorActiveBrush" Color="#EDE6DA" />
      <SolidColorBrush x:Key="CarouselIndicatorInactiveBrush" Color="#4A443B" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <FontFamily x:Key="CarouselDisplayFontFamily">ms-appx:///Assets/Fonts/InstrumentSerif-Regular.ttf#Instrument Serif</FontFamily>
  <FontFamily x:Key="CarouselStrongFontFamily">ms-appx:///Assets/Fonts/InstrumentSans-SemiBold.ttf#Instrument Sans SemiBold</FontFamily>
  <Color x:Key="CarouselShadowColor">#46301C</Color>

  <!-- Type for captions. Hosts use these in their CaptionTemplate. -->
  <Style x:Key="CarouselTitleTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource CarouselDisplayFontFamily}" />
    <Setter Property="FontSize" Value="34" />
    <Setter Property="LineHeight" Value="36" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxLines" Value="2" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Foreground" Value="{ThemeResource CarouselInkBrush}" />
  </Style>
  <Style x:Key="CarouselHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CarouselTitleTextStyle}">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="LineHeight" Value="33" />
    <Setter Property="MaxLines" Value="1" />
  </Style>
  <Style x:Key="CarouselBodyTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MaterialRegularFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{ThemeResource CarouselMutedBrush}" />
  </Style>
  <Style x:Key="CarouselMetaTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CarouselBodyTextStyle}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
  </Style>
  <!-- CharacterSpacing is a no-op on the Uno Skia text stack; it applies where the platform honours it. -->
  <Style x:Key="CarouselLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CarouselMetaTextStyle}">
    <Setter Property="CharacterSpacing" Value="120" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!-- 44 px round outlined transport button: hover fills with the mat, press darkens and scales to 0.96. -->
  <Style x:Key="CarouselTransportButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{ThemeResource CarouselInkBrush}" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CarouselInkBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="PressScale" />
            </Grid.RenderTransform>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Chrome.Background" Value="{ThemeResource CarouselButtonHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Chrome.Background" Value="{ThemeResource CarouselButtonPressedBrush}" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.12" />
                    <DoubleAnimation Storyboard.TargetName="PressScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.12" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Chrome"
                    Background="Transparent"
                    BorderBrush="{ThemeResource CarouselControlOutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="22" />
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Content}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 28 px pill button ("Try again"). -->
  <Style x:Key="CarouselPillButtonStyle" TargetType="Button">
    <Setter Property="Height" Value="28" />
    <Setter Property="Foreground" Value="{ThemeResource CarouselInkBrush}" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CarouselInkBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontFamily" Value="{StaticResource CarouselStrongFontFamily}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="PressScale" />
            </Grid.RenderTransform>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Chrome.Background" Value="{ThemeResource CarouselButtonHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Chrome.Background" Value="{ThemeResource CarouselButtonPressedBrush}" />
                    <Setter Target="PressScale.ScaleX" Value="0.96" />
                    <Setter Target="PressScale.ScaleY" Value="0.96" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Chrome"
                    Background="Transparent"
                    BorderBrush="{ThemeResource CarouselControlOutlineBrush}"
                    BorderThickness="1"
                    CornerRadius="14" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Content}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CarouselThumbnailButtonStyle" TargetType="local:CarouselThumbnail">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="-6,-6,-6,2" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CarouselInkBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:CarouselThumbnail">
          <Grid Background="Transparent">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="6" />
              <RowDefinition Height="2" />
            </Grid.RowDefinitions>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="Opacity" To="0.62" Duration="0:0:0.2" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerOver">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                  </Storyboard>
                  <VisualState.Setters>
                    <Setter Target="PressScale.ScaleX" Value="0.96" />
                    <Setter Target="PressScale.ScaleY" Value="0.96" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled" />
                <VisualState x:Name="Checked">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                  </Storyboard>
                  <VisualState.Setters>
                    <Setter Target="Ring.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                  </Storyboard>
                  <VisualState.Setters>
                    <Setter Target="Ring.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                  </Storyboard>
                  <VisualState.Setters>
                    <Setter Target="Ring.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- Current: a 2 px ink ring with a 2 px gap (box-shadow 0 0 0 2px bg, 0 0 0 4px ink). -->
            <Border x:Name="Ring"
                    Margin="-4"
                    BorderBrush="{ThemeResource CarouselInkBrush}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Opacity="0" />
            <Border x:Name="Frame"
                    Opacity="0.62"
                    CornerRadius="4"
                    RenderTransformOrigin="0.5,0.5"
                    Background="{ThemeResource CarouselPlaceholderBrush}">
              <Border.RenderTransform>
                <ScaleTransform x:Name="PressScale" />
              </Border.RenderTransform>
              <ContentPresenter Content="{TemplateBinding Content}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Border>
            <Border Grid.Row="2"
                    Background="{ThemeResource CarouselLineBrush}"
                    CornerRadius="1">
              <Border x:Name="PART_ProgressFill"
                      Background="{ThemeResource CarouselInkBrush}"
                      CornerRadius="1" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="local:CarouselThumbnail" BasedOn="{StaticResource CarouselThumbnailButtonStyle}" />

  <Style TargetType="local:Carousel">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="IsTabStop" Value="True" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="-6" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CarouselInkBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource MaterialRegularFontFamily}" />
    <Setter Property="Foreground" Value="{ThemeResource CarouselInkBrush}" />
    <Setter Property="InactiveItemOpacity" Value="0.72" />
    <Setter Property="ThumbnailStyle" Value="{StaticResource CarouselThumbnailButtonStyle}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:Carousel">
            <Grid x:Name="LayoutRoot"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}"
                  CornerRadius="{TemplateBinding CornerRadius}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <VisualStateManager.VisualStateGroups>
                <!-- The local values below are the narrow layout (header, items, caption, thumbnails). -->
                <VisualStateGroup x:Name="PlacementStates">
                  <VisualState x:Name="Bottom" />
                  <VisualState x:Name="Side">
                    <VisualState.Setters>
                                            <Setter Target="PART_ClipGrid.(Grid.Row)" Value="0" />
                      <Setter Target="PART_ClipGrid.(Grid.RowSpan)" Value="6" />
                      <Setter Target="PART_ClipGrid.Padding" Value="2,2,0,30" />
                      <Setter Target="PART_PositionText.(Grid.Column)" Value="1" />
                      <Setter Target="PART_PositionText.(Grid.Row)" Value="0" />
                      <Setter Target="PART_PositionText.HorizontalAlignment" Value="Left" />
                      <Setter Target="PART_PositionText.Margin" Value="44,6,0,0" />
                      <Setter Target="PART_PositionText.Width" Value="320" />
                      <Setter Target="CaptionHost.(Grid.Column)" Value="1" />
                      <Setter Target="CaptionHost.(Grid.Row)" Value="1" />
                      <Setter Target="CaptionHost.Margin" Value="44,14,0,0" />
                      <Setter Target="CaptionHost.Height" Value="176" />
                      <Setter Target="CaptionHost.Width" Value="320" />
                      <Setter Target="ThumbBlock.(Grid.Column)" Value="1" />
                      <Setter Target="ThumbBlock.(Grid.Row)" Value="3" />
                      <Setter Target="ThumbBlock.Margin" Value="44,0,0,0" />
                      <Setter Target="ThumbBlock.Padding" Value="0,18,0,0" />
                      <Setter Target="ThumbBlock.BorderThickness" Value="0,1,0,0" />
                      <Setter Target="ThumbBlock.Width" Value="320" />
                      <Setter Target="PART_TransportRow.(Grid.Column)" Value="1" />
                      <Setter Target="PART_TransportRow.(Grid.Row)" Value="4" />
                      <Setter Target="PART_TransportRow.Margin" Value="44,18,0,30" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="PlaybackStates">
                  <VisualState x:Name="Off">
                    <VisualState.Setters>
                      <Setter Target="PART_PlayPauseButton.Visibility" Value="Collapsed" />
                      <Setter Target="PART_StatusText.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                  </VisualState>
                  <VisualState x:Name="Playing" />
                  <VisualState x:Name="Held" />
                  <VisualState x:Name="Paused">
                    <VisualState.Setters>
                      <Setter Target="PauseIcon.Visibility" Value="Collapsed" />
                      <Setter Target="PlayIcon.Visibility" Value="Visible" />
                    </VisualState.Setters>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>

              <!-- Narrow header: title on the left, "02 / 05" on the right. -->
              <ContentPresenter x:Name="HeaderRow"
                                Margin="0,0,72,18"
                                VerticalAlignment="Bottom"
                                Content="{TemplateBinding Header}">
                <ContentPresenter.ContentTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource CarouselHeaderTextStyle}" />
                  </DataTemplate>
                </ContentPresenter.ContentTemplate>
              </ContentPresenter>

              <TextBlock x:Name="PART_PositionText"
                         Margin="0,0,0,24"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Style="{StaticResource CarouselLabelTextStyle}"
                         AutomationProperties.LiveSetting="Polite" />

              <!-- Items. The bottom padding leaves room for the plates' shadow inside the clip. -->
              <Grid x:Name="PART_ClipGrid"
                    Grid.Row="2"
                    Padding="0,0,0,14"
                    Background="Transparent">
                <local:CarouselPanel x:Name="PART_ItemsPanel"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch" />
              </Grid>

              <!-- Caption of the selected item, cross-faded between two presenters. -->
              <Grid x:Name="CaptionHost"
                    Grid.Row="3"
                    MinHeight="84"
                    Margin="0,0,0,18">
                <ContentPresenter x:Name="PART_CaptionPresenterA" />
                <ContentPresenter x:Name="PART_CaptionPresenterB" Opacity="0" />
              </Grid>

              <Border x:Name="ThumbBlock"
                      Grid.Row="4"
                      BorderBrush="{ThemeResource CarouselLineBrush}"
                      BorderThickness="0">
                <Grid>
                  <local:CarouselThumbnailPanel x:Name="PART_ThumbnailPanel" MinSpacing="10" />
                  <local:CarouselIndicator x:Name="PART_IndicatorPanel"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,4"
                                           ActiveBrush="{ThemeResource CarouselIndicatorActiveBrush}"
                                           InactiveBrush="{ThemeResource CarouselIndicatorInactiveBrush}"
                                           Visibility="{TemplateBinding IndicatorVisibility}" />
                </Grid>
              </Border>

              <StackPanel x:Name="PART_TransportRow"
                          Grid.Row="5"
                          Margin="0,18,0,0"
                          Orientation="Horizontal"
                          Spacing="10">
                <Button x:Name="PART_PreviousButton" Style="{StaticResource CarouselTransportButtonStyle}">
                  <Viewbox Width="20" Height="20">
                    <Path Width="24" Height="24" Data="M15,6 L9,12 L15,18"
                          Stroke="{ThemeResource CarouselInkBrush}" StrokeThickness="1.75"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Viewbox>
                </Button>
                <Button x:Name="PART_PlayPauseButton" Style="{StaticResource CarouselTransportButtonStyle}">
                  <Grid>
                    <Viewbox x:Name="PauseIcon" Width="20" Height="20">
                      <Path Width="24" Height="24" Data="M6,5 H10 V19 H6 Z M14,5 H18 V19 H14 Z"
                            Stroke="{ThemeResource CarouselInkBrush}" StrokeThickness="1.75" StrokeLineJoin="Round" />
                    </Viewbox>
                    <!-- Optical centre: the triangle sits 1 px right of the geometric centre. -->
                    <Viewbox x:Name="PlayIcon" Width="20" Height="20" Margin="2,0,0,0" Visibility="Collapsed">
                      <Path Width="24" Height="24" Data="M7,5 L18,12 L7,19 Z"
                            Stroke="{ThemeResource CarouselInkBrush}" StrokeThickness="1.75" StrokeLineJoin="Round" />
                    </Viewbox>
                  </Grid>
                </Button>
                <Button x:Name="PART_NextButton" Style="{StaticResource CarouselTransportButtonStyle}">
                  <Viewbox Width="20" Height="20">
                    <Path Width="24" Height="24" Data="M9,6 L15,12 L9,18"
                          Stroke="{ThemeResource CarouselInkBrush}" StrokeThickness="1.75"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                  </Viewbox>
                </Button>
                <TextBlock x:Name="PART_StatusText"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource CarouselMetaTextStyle}"
                           TextWrapping="NoWrap" />
              </StackPanel>
            </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="local:CarouselPlate">
    <Setter Property="Padding" Value="14" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="FontFamily" Value="{StaticResource MaterialRegularFontFamily}" />
    <Setter Property="Foreground" Value="{ThemeResource CarouselInkBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:CarouselPlate">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="PlateStates">
                <VisualState x:Name="Ready" />
                <!-- Loading keeps the mat, the ratio and the caption's size: spinner and skeleton bars. -->
                <VisualState x:Name="Loading">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                     Storyboard.TargetProperty="Angle"
                                     From="0"
                                     To="360"
                                     Duration="0:0:2.4"
                                     RepeatBehavior="Forever" />
                  </Storyboard>
                  <VisualState.Setters>
                    <Setter Target="LoadingLayer.Visibility" Value="Visible" />
                    <Setter Target="CaptionText.Opacity" Value="0" />
                    <Setter Target="CaptionSkeleton.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
                <!-- Failed: the caption and the carousel's navigation keep working. -->
                <VisualState x:Name="Failed">
                  <VisualState.Setters>
                    <Setter Target="PART_Image.Opacity" Value="0" />
                    <Setter Target="FailedLayer.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CaptionStates">
                <VisualState x:Name="NoCaption" />
                <VisualState x:Name="WithCaption">
                  <VisualState.Setters>
                    <Setter Target="CaptionArea.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <local:ShadowContainer Background="{ThemeResource CarouselMatBrush}">
              <local:ShadowContainer.Shadows>
                <local:ShadowCollection>
                  <local:Shadow OffsetY="18" BlurRadius="32" Spread="-24" Opacity="0.45" Color="{StaticResource CarouselShadowColor}" />
                </local:ShadowCollection>
              </local:ShadowContainer.Shadows>
              <Border Padding="{TemplateBinding Padding}"
                      BorderBrush="{ThemeResource CarouselMatLineBrush}"
                      BorderThickness="1"
                      CornerRadius="4">
                <Border CornerRadius="2" Background="{ThemeResource CarouselPlaceholderBrush}">
                  <Grid>
                    <Image x:Name="PART_Image" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Grid x:Name="LoadingLayer" Visibility="Collapsed">
                      <!-- One arc turning every 2.4 s, linear; the storyboard only runs in the Loading state. -->
                      <Path x:Name="Spinner"
                            Width="20"
                            Height="20"
                            Data="M10,2 A8,8 0 1 1 2.4,7.5"
                            Stroke="{ThemeResource CarouselMutedBrush}"
                            StrokeThickness="1.75"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            RenderTransformOrigin="0.5,0.5"
                            AutomationProperties.Name="Loading">
                        <Path.RenderTransform>
                          <RotateTransform x:Name="SpinnerRotation" />
                        </Path.RenderTransform>
                      </Path>
                    </Grid>
                    <StackPanel x:Name="FailedLayer"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                Visibility="Collapsed">
                      <Viewbox Width="20" Height="20" HorizontalAlignment="Center">
                        <Path Width="24" Height="24"
