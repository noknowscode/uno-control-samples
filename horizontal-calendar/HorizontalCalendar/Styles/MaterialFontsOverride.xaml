<!--
    Schibsted Grotesk for the Material type ramp (the Horizontal Calendar sheet's typeface). Static instances cut from
    the variable font, one file per weight, because the Skia text stack renders a variable font's default instance only.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="MaterialLightFontFamily">ms-appx:///Assets/Fonts/SchibstedGrotesk-Regular.ttf#Schibsted Grotesk</FontFamily>
  <FontFamily x:Key="MaterialRegularFontFamily">ms-appx:///Assets/Fonts/SchibstedGrotesk-Regular.ttf#Schibsted Grotesk</FontFamily>
  <FontFamily x:Key="MaterialMediumFontFamily">ms-appx:///Assets/Fonts/SchibstedGrotesk-Medium.ttf#Schibsted Grotesk Medium</FontFamily>
</ResourceDictionary>
