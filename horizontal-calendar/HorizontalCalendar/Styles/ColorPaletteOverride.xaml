<!--
    The palette: the one place this sample's Material role colours live. MaterialToolkitTheme reads it through
    ColorOverrideSource (App.xaml) and generates every role brush from it. Uno Platform Studio's Themes tab edits it.
    All 33 roles are set in both themes. Light is the Control Gallery "Horizontal Calendar" sheet: ground #F5F6F8,
    card #FFFFFF, navy ink #0F1B2D, muted #556070, hairline #DCE0E6, outline #848E9D and the cobalt accent #2B59FF.
    Dark keeps the navy and cobalt identity on a navy ground. The calendar's own tokens (hatching, ticks, hover) are
    in Controls/HorizontalCalendar/HorizontalCalendar.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="PrimaryColor">#2B59FF</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
      <Color x:Key="PrimaryContainerColor">#EDF1FF</Color>
      <Color x:Key="OnPrimaryContainerColor">#0A2A99</Color>
      <Color x:Key="SecondaryColor">#556070</Color>
      <Color x:Key="OnSecondaryColor">#FFFFFF</Color>
      <Color x:Key="SecondaryContainerColor">#EEF1F5</Color>
      <Color x:Key="OnSecondaryContainerColor">#0F1B2D</Color>
      <Color x:Key="TertiaryColor">#0B7A75</Color>
      <Color x:Key="OnTertiaryColor">#FFFFFF</Color>
      <Color x:Key="TertiaryContainerColor">#D4F2EF</Color>
      <Color x:Key="OnTertiaryContainerColor">#03302E</Color>
      <Color x:Key="ErrorColor">#B3261E</Color>
      <Color x:Key="OnErrorColor">#FFFFFF</Color>
      <Color x:Key="ErrorContainerColor">#F9DEDC</Color>
      <Color x:Key="OnErrorContainerColor">#410E0B</Color>
      <Color x:Key="BackgroundColor">#F5F6F8</Color>
      <Color x:Key="OnBackgroundColor">#0F1B2D</Color>
      <Color x:Key="SurfaceColor">#FFFFFF</Color>
      <Color x:Key="OnSurfaceColor">#0F1B2D</Color>
      <Color x:Key="SurfaceVariantColor">#EEF1F5</Color>
      <Color x:Key="OnSurfaceVariantColor">#556070</Color>
      <Color x:Key="OutlineColor">#848E9D</Color>
      <Color x:Key="OutlineVariantColor">#DCE0E6</Color>
      <Color x:Key="SurfaceInverseColor">#0F1B2D</Color>
      <Color x:Key="OnSurfaceInverseColor">#F5F6F8</Color>
      <Color x:Key="PrimaryInverseColor">#9DB2FF</Color>
      <Color x:Key="SurfaceTintColor">#2B59FF</Color>
      <Color x:Key="ShadowColor">#33000000</Color>
      <Color x:Key="PrimaryVariantDarkColor">#1A3FCC</Color>
      <Color x:Key="PrimaryVariantLightColor">#EDF1FF</Color>
      <Color x:Key="SecondaryVariantDarkColor">#3A4453</Color>
      <Color x:Key="SecondaryVariantLightColor">#EEF1F5</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <Color x:Key="PrimaryColor">#9DB2FF</Color>
      <Color x:Key="OnPrimaryColor">#0A1F66</Color>
      <Color x:Key="PrimaryContainerColor">#1A3FCC</Color>
      <Color x:Key="OnPrimaryContainerColor">#EDF1FF</Color>
      <Color x:Key="SecondaryColor">#9AA6B8</Color>
      <Color x:Key="OnSecondaryColor">#1B2433</Color>
      <Color x:Key="SecondaryContainerColor">#263244</Color>
      <Color x:Key="OnSecondaryContainerColor">#E8EDF5</Color>
      <Color x:Key="TertiaryColor">#6FD3CB</Color>
      <Color x:Key="OnTertiaryColor">#03302E</Color>
      <Color x:Key="TertiaryContainerColor">#0B5551</Color>
      <Color x:Key="OnTertiaryContainerColor">#D4F2EF</Color>
      <Color x:Key="ErrorColor">#F2B8B5</Color>
      <Color x:Key="OnErrorColor">#601410</Color>
      <Color x:Key="ErrorContainerColor">#8C1D18</Color>
      <Color x:Key="OnErrorContainerColor">#F9DEDC</Color>
      <Color x:Key="BackgroundColor">#0B111B</Color>
      <Color x:Key="OnBackgroundColor">#E8EDF5</Color>
      <Color x:Key="SurfaceColor">#121A27</Color>
      <Color x:Key="OnSurfaceColor">#E8EDF5</Color>
      <Color x:Key="SurfaceVariantColor">#1A2333</Color>
      <Color x:Key="OnSurfaceVariantColor">#9AA6B8</Color>
      <Color x:Key="OutlineColor">#5E6B7F</Color>
      <Color x:Key="OutlineVariantColor">#263244</Color>
      <Color x:Key="SurfaceInverseColor">#E8EDF5</Color>
      <Color x:Key="OnSurfaceInverseColor">#121A27</Color>
      <Color x:Key="PrimaryInverseColor">#2B59FF</Color>
      <Color x:Key="SurfaceTintColor">#9DB2FF</Color>
      <Color x:Key="ShadowColor">#66000000</Color>
      <Color x:Key="PrimaryVariantDarkColor">#2B59FF</Color>
      <Color x:Key="PrimaryVariantLightColor">#EDF1FF</Color>
      <Color x:Key="SecondaryVariantDarkColor">#1B2433</Color>
      <Color x:Key="SecondaryVariantLightColor">#9AA6B8</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
