<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:HorizontalCalendar.Controls">

  <!-- Design tokens from the Control Gallery "Horizontal Calendar" sheet. Light is the sheet's palette; Dark keeps
       the navy ink and the cobalt accent on a navy ground. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="CalendarCardBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CalendarInkBrush" Color="#0F1B2D" />
      <SolidColorBrush x:Key="CalendarMutedBrush" Color="#556070" />
      <SolidColorBrush x:Key="CalendarLineBrush" Color="#DCE0E6" />
      <SolidColorBrush x:Key="CalendarControlOutlineBrush" Color="#848E9D" />
      <SolidColorBrush x:Key="CalendarSkeletonBrush" Color="#E8EBF0" />
      <SolidColorBrush x:Key="CalendarHoverBrush" Color="#EEF1F5" />
      <SolidColorBrush x:Key="CalendarHatchBrush" Color="#E6E9EE" />
      <SolidColorBrush x:Key="CalendarHatchHoverBrush" Color="#DCE0E6" />
      <SolidColorBrush x:Key="CalendarLegendHatchBrush" Color="#C9CFD8" />
      <SolidColorBrush x:Key="CalendarAccentBrush" Color="#2B59FF" />
      <SolidColorBrush x:Key="CalendarAccentHoverBrush" Color="#4069FF" />
      <SolidColorBrush x:Key="CalendarOnAccentBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CalendarTickBrush" Color="#2B59FF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="CalendarCardBrush" Color="#121A27" />
      <SolidColorBrush x:Key="CalendarInkBrush" Color="#E8EDF5" />
      <SolidColorBrush x:Key="CalendarMutedBrush" Color="#9AA6B8" />
      <SolidColorBrush x:Key="CalendarLineBrush" Color="#263244" />
      <SolidColorBrush x:Key="CalendarControlOutlineBrush" Color="#5E6B7F" />
      <SolidColorBrush x:Key="CalendarSkeletonBrush" Color="#1E2838" />
      <SolidColorBrush x:Key="CalendarHoverBrush" Color="#1A2333" />
      <SolidColorBrush x:Key="CalendarHatchBrush" Color="#263244" />
      <SolidColorBrush x:Key="CalendarHatchHoverBrush" Color="#33415A" />
      <SolidColorBrush x:Key="CalendarLegendHatchBrush" Color="#3A475C" />
      <SolidColorBrush x:Key="CalendarAccentBrush" Color="#2B59FF" />
      <SolidColorBrush x:Key="CalendarAccentHoverBrush" Color="#4069FF" />
      <SolidColorBrush x:Key="CalendarOnAccentBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CalendarTickBrush" Color="#7C9BFF" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Static instances of the sheet's variable fonts, one file per weight. -->
  <FontFamily x:Key="CalendarRegularFontFamily">ms-appx:///Assets/Fonts/SchibstedGrotesk-Regular.ttf#Schibsted Grotesk</FontFamily>
  <FontFamily x:Key="CalendarMediumFontFamily">ms-appx:///Assets/Fonts/SchibstedGrotesk-Medium.ttf#Schibsted Grotesk Medium</FontFamily>
  <FontFamily x:Key="CalendarSemiBoldFontFamily">ms-appx:///Assets/Fonts/SchibstedGrotesk-SemiBold.ttf#Schibsted Grotesk SemiBold</FontFamily>
  <FontFamily x:Key="CalendarMonoFontFamily">ms-appx:///Assets/Fonts/AzeretMono-Regular.ttf#Azeret Mono</FontFamily>
  <FontFamily x:Key="CalendarMonoMediumFontFamily">ms-appx:///Assets/Fonts/AzeretMono-Medium.ttf#Azeret Mono Medium</FontFamily>

  <!-- Icons are 24-unit paths stroked 1.75 (the sheet's icon set). -->

  <Style x:Key="CalendarIconPathStyle" TargetType="Path">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="StrokeThickness" Value="1.75" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="StrokeLineJoin" Value="Round" />
  </Style>

  <!-- Outline button: radius 10, outline #848E9D, hover fill #EEF1F5, press 0.96, disabled 35 %. -->
  <Style x:Key="CalendarOutlineButtonStyle" TargetType="Button">
    <Setter Property="Height" Value="40" />
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{ThemeResource CalendarControlOutlineBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource CalendarInkBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource CalendarMediumFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="-3" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CalendarInkBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="PressScale" />
            </Grid.RenderTransform>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Chrome.Background" Value="{ThemeResource CalendarHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Chrome.Background" Value="{ThemeResource CalendarHoverBrush}" />
                    <Setter Target="PressScale.ScaleX" Value="0.96" />
                    <Setter Target="PressScale.ScaleY" Value="0.96" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.35" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CalendarIconButtonStyle" TargetType="Button" BasedOn="{StaticResource CalendarOutlineButtonStyle}">
    <Setter Property="Width" Value="40" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- Borderless 40 px button ("More options"). -->
  <Style x:Key="CalendarGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource CalendarIconButtonStyle}">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Small outline button in the empty and error states: 32 px, 13 px SemiBold. -->
  <Style x:Key="CalendarSmallOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource CalendarOutlineButtonStyle}">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="10,0,12,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontFamily" Value="{StaticResource CalendarSemiBoldFontFamily}" />
  </Style>

  <!-- Cobalt pill: "Add event". -->
  <Style x:Key="CalendarAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource CalendarOutlineButtonStyle}">
    <Setter Property="Padding" Value="14,0,18,0" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{ThemeResource CalendarAccentBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource CalendarOnAccentBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource CalendarSemiBoldFontFamily}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="PressScale" />
            </Grid.RenderTransform>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Chrome.Background" Value="{ThemeResource CalendarAccentHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="PressScale.ScaleX" Value="0.96" />
                    <Setter Target="PressScale.ScaleY" Value="0.96" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.35" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CalendarMutedTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource CalendarRegularFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="Foreground" Value="{ThemeResource CalendarMutedBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <Style x:Key="CalendarStrongTextStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource CalendarSemiBoldFontFamily}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{ThemeResource CalendarInkBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!-- One day of the strip. -->
  <Style TargetType="local:CalendarDayButton">
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="2" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource CalendarInkBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:CalendarDayButton">
          <Grid x:Name="Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="SelectionStates">
                <VisualState x:Name="Unselected" />
                <VisualState x:Name="Selected">
                  <VisualState.Setters>
                    <Setter Target="WeekdayText.Foreground" Value="{ThemeResource CalendarOnAccentBrush}" />
                    <Setter Target="NumberText.Foreground" Value="{ThemeResource CalendarOnAccentBrush}" />
                    <Setter Target="Tick1.Background" Value="{ThemeResource CalendarOnAccentBrush}" />
                    <Setter Target="Tick2.Background" Value="{ThemeResource CalendarOnAccentBrush}" />
                    <Setter Target="Tick3.Background" Value="{ThemeResource CalendarOnAccentBrush}" />
                    <Setter Target="Tick4.Background" Value="{ThemeResource CalendarOnAccentBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="TodayStates">
                <VisualState x:Name="NotToday" />
                <VisualState x:Name="Today">
                  <VisualState.Setters>
                    <Setter Target="TodayRing.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
                <!-- Today and selected: a white ring 3 px inside the pill. -->
                <VisualState x:Name="TodaySelected">
                  <VisualState.Setters>
                    <Setter Target="TodayRing.Visibility" Value="Visible" />
                    <Setter Target="TodayRing.Margin" Value="3" />
                    <Setter Target="TodayRing.BorderBrush" Value="{ThemeResource CalendarOnAccentBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="AvailabilityStates">
                <VisualState x:Name="Available" />
                <VisualState x:Name="Past">
                  <VisualState.Setters>
                    <Setter Target="NumberText.Foreground" Value="{ThemeResource CalendarMutedBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <!-- Hatched, struck through, labelled; focusable but not selectable. -->
                <VisualState x:Name="Unavailable">
                  <VisualState.Setters>
                    <Setter Target="HatchClip.Visibility" Value="Visible" />
                    <Setter Target="NumberText.Foreground" Value="{ThemeResource CalendarMutedBrush}" />
                    <Setter Target="NumberText.TextDecorations" Value="Strikethrough" />
                    <Setter Target="PART_Ticks.Visibility" Value="Collapsed" />
                    <Setter Target="UnavailableText.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="PointerStates">
                <VisualState x:Name="Rest" />
                <VisualState x:Name="Hover">
                  <VisualState.Setters>
                    <Setter Target="HoverFill.Background" Value="{ThemeResource CalendarHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="HatchHover">
                  <VisualState.Setters>
                    <Setter Target="PART_Hatch.Stroke" Value="{ThemeResource CalendarHatchHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="SizeStates">
                <VisualState x:Name="Regular" />
                <VisualState x:Name="Compact">
                  <VisualState.Setters>
                    <Setter Target="HoverFill.CornerRadius" Value="10" />
                    <Setter Target="HatchClip.CornerRadius" Value="10" />
                    <Setter Target="TodayRing.CornerRadius" Value="10" />
                    <Setter Target="Stack.Spacing" Value="4" />
                    <Setter Target="WeekdayText.FontSize" Value="10" />
                    <Setter Target="NumberText.FontSize" Value="20" />
                    <Setter Target="UnavailableText.FontSize" Value="8" />
                    <Setter Target="UnavailableText.Margin" Value="0" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Border x:Name="HoverFill" CornerRadius="14" Background="Transparent" />
            <Border x:Name="HatchClip" CornerRadius="14" Visibility="Collapsed">
              <Path x:Name="PART_Hatch" Stroke="{ThemeResource CalendarHatchBrush}" StrokeThickness="1" />
            </Border>
            <StackPanel x:Name="Stack" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
              <TextBlock x:Name="WeekdayText"
                         HorizontalAlignment="Center"
                         FontFamily="{StaticResource CalendarMonoFontFamily}"
                         FontSize="11"
                         Foreground="{ThemeResource CalendarMutedBrush}" />
              <TextBlock x:Name="NumberText"
                         HorizontalAlignment="Center"
                         FontFamily="{StaticResource CalendarSemiBoldFontFamily}"
                         FontSize="26"
                         LineHeight="26"
                         LineStackingStrategy="BlockLineHeight"
                         Foreground="{ThemeResource CalendarInkBrush}" />
              <StackPanel x:Name="PART_Ticks" Height="3" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="3">
                <Border x:Name="Tick1" Width="8" Height="3" CornerRadius="1.5" Background="{ThemeResource CalendarTickBrush}" />
                <Border x:Name="Tick2" Width="8" Height="3" CornerRadius="1.5" Background="{ThemeResource CalendarTickBrush}" />
                <Border x:Name="Tick3" Width="8" Height="3" CornerRadius="1.5" Background="{ThemeResource CalendarTickBrush}" />
                <Border x:Name="Tick4" Width="8" Height="3" CornerRadius="1.5" Background="{ThemeResource CalendarTickBrush}" />
              </StackPanel>
              <TextBlock x:Name="UnavailableText"
                         Margin="0,-4,0,0"
                         HorizontalAlignment="Center"
                         FontFamily="{StaticResource CalendarMonoFontFamily}"
                         FontSize="10"
                         Foreground="{ThemeResource CalendarMutedBrush}"
                         Visibility="Collapsed" />
            </StackPanel>
            <Border x:Name="TodayRing"
                    BorderBrush="{ThemeResource CalendarInkBrush}"
                    BorderThickness="1.5"
                    CornerRadius="14"
                    Visibility="Collapsed" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="local:HorizontalCalendar">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="FontFamily" Value="{StaticResource CalendarRegularFontFamily}" />
    <Setter Property="Foreground" Value="{ThemeResource CalendarInkBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:HorizontalCalendar">
          <Grid x:Name="RootGrid">
            <VisualStateManager.VisualStateGroups>
              <!-- Local values are the regular layout (Fig. 1); Compact is the 390 px phone layout (Fig. 3). -->
              <VisualStateGroup x:Name="DisplayStates">
                <VisualState x:Name="Regular" />
                <VisualState x:Name="Compact">
                  <VisualState.Setters>
                    <Setter Target="Card.Background" Value="Transparent" />
                    <Setter Target="Card.BorderThickness" Value="0" />
                    <Setter Target="Card.Padding" Value="0" />
                    <Setter Target="Card.CornerRadius" Value="0" />
                                        <Setter Target="HeaderRow.Margin" Value="0,0,0,14" />
                    <Setter Target="TitleStack.Orientation" Value="Vertical" />
                    <Setter Target="TitleStack.Spacing" Value="0" />
                    <Setter Target="TitleStack.VerticalAlignment" Value="Center" />
                    <Setter Target="MonthText.FontSize" Value="28" />
                    <Setter Target="TodayButton.Visibility" Value="Collapsed" />
                    <Setter Target="PreviousWeekButton.Width" Value="44" />
                    <Setter Target="PreviousWeekButton.Height" Value="44" />
                    <Setter Target="NextWeekButton.Width" Value="44" />
                    <Setter Target="NextWeekButton.Height" Value="44" />
                    <Setter Target="PART_Viewport.Margin" Value="0" />
                    <Setter Target="PART_Pill.CornerRadius" Value="10" />
                    <Setter Target="Legend.Visibility" Value="Collapsed" />
                    <Setter Target="AgendaBorder.BorderThickness" Value="0" />
                    <Setter Target="AgendaHeader.MinHeight" Value="0" />
                    <Setter Target="AgendaHeader.Margin" Value="0,20,0,8" />
                    <Setter Target="AgendaSummary.HorizontalAlignment" Value="Right" />
                    <Setter Target="AddEventButton.Visibility" Value="Collapsed" />
                    <Setter Target="Rows.Visibility" Value="Collapsed" />
                    <Setter Target="CompactRows.Visibility" Value="Visible" />
                    <Setter Target="LoadingRows.Visibility" Value="Collapsed" />
                    <Setter Target="CompactLoadingRows.Visibility" Value="Visible" />
                    <Setter Target="CompactDock.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="AgendaStates">
                <VisualState x:Name="Events">
                  <VisualState.Setters>
                    <Setter Target="EventsArea.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
                <!-- Same height as a busy day: the empty message fills the agenda. -->
                <VisualState x:Name="Empty">
                  <VisualState.Setters>
                    <Setter Target="EmptyArea.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
                <!-- Dates stay usable; skeleton rows hold their height. -->
                <VisualState x:Name="Loading">
                  <VisualState.Setters>
                    <Setter Target="LoadingArea.Visibility" Value="Visible" />
                    <Setter Target="AgendaSummary.Opacity" Value="0" />
                  </VisualState.Setters>
                </VisualState>
                <!-- Only the agenda is replaced; the selected day is kept. -->
                <VisualState x:Name="Error">
                  <VisualState.Setters>
                    <Setter Target="ErrorArea.Visibility" Value="Visible" />
                    <Setter Target="AgendaSummary.Opacity" Value="0" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Border x:Name="Card"
                    Padding="22,20,22,14"
                    Background="{ThemeResource CalendarCardBrush}"
                    BorderBrush="{ThemeResource CalendarLineBrush}"
                    BorderThickness="1"
                    CornerRadius="32">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: month and week range; Today and the week buttons. -->
                <Grid x:Name="HeaderRow" MinHeight="40" ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel x:Name="TitleStack" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <TextBlock x:Name="MonthText"
                               FontFamily="{StaticResource CalendarSemiBoldFontFamily}"
                               FontSize="24"
                               Foreground="{ThemeResource CalendarInkBrush}" />
                    <TextBlock x:Name="RangeText"
                               VerticalAlignment="Bottom"
                               Style="{StaticResource CalendarMutedTextStyle}"
                               AutomationProperties.LiveSetting="Polite" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="TodayButton" Content="Today" Style="{StaticResource CalendarOutlineButtonStyle}" />
                    <Button x:Name="PreviousWeekButton" Style="{StaticResource CalendarIconButtonStyle}" AutomationProperties.Name="Previous week">
                      <Viewbox Width="20" Height="20">
                        <Path Data="M15,6 L9,12 L15,18" Style="{StaticResource CalendarIconPathStyle}" Stroke="{ThemeResource CalendarInkBrush}" />
                      </Viewbox>
                    </Button>
                    <Button x:Name="NextWeekButton" Style="{StaticResource CalendarIconButtonStyle}" AutomationProperties.Name="Next week">
                      <Viewbox Width="20" Height="20">
                        <Path Data="M9,6 L15,12 L9,18" Style="{StaticResource CalendarIconPathStyle}" Stroke="{ThemeResource CalendarInkBrush}" />
                      </Viewbox>
                    </Button>
                  </StackPanel>
                </Grid>

                <!-- The week strip: three weeks in a clipped viewport; the pill is the panel's first child. -->
                <Grid x:Name="PART_Viewport"
                      Grid.Row="1"
                      Margin="0,12,0,0"
                      AutomationProperties.Name="Days">
                  <local:CalendarWeekPanel x:Name="PART_WeekPanel">
                    <Border x:Name="PART_Pill" CornerRadius="14" Background="{ThemeResource CalendarAccentBrush}" />
                  </local:CalendarWeekPanel>
                </Grid>

                <StackPanel x:Name="Legend"
                            Grid.Row="2"
                            Height="30"
                            Padding="6,0"
                            Orientation="Horizontal"
                            Spacing="20"
                            Visibility="{TemplateBinding LegendVisibility}"
                            AutomationProperties.AccessibilityView="Raw">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="14" Height="14" CornerRadius="4" Background="{ThemeResource CalendarAccentBrush}" />
                    <TextBlock Text="Selected" FontSize="12" Foreground="{ThemeResource CalendarMutedBrush}" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="14" Height="14" CornerRadius="4" BorderThickness="1.5" BorderBrush="{ThemeResource CalendarInkBrush}" />
                    <TextBlock Text="Today" FontSize="12" Foreground="{ThemeResource CalendarMutedBrush}" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                      <Border Width="8" Height="3" CornerRadius="1.5" Background="{ThemeResource CalendarTickBrush}" />
                      <Border Width="7" Height="3" CornerRadius="1.5" Background="{ThemeResource CalendarTickBrush}" />
                    </StackPanel>
                    <TextBlock Text="One tick per event" FontSize="12" Foreground="{ThemeResource CalendarMutedBrush}" VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="14" Height="14" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource CalendarLineBrush}">
                      <Path Data="M0,4 L4,0 M0,8 L8,0 M0,12 L12,0 M2,14 L14,2 M6,14 L14,6 M10,14 L14,10"
                            Stroke="{ThemeResource CalendarLegendHatchBrush}"
                            StrokeThickness="1" />
                    </Border>
                    <TextBlock Text="Unavailable" FontSize="12" Foreground="{ThemeResource CalendarMutedBrush}" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>

                <!-- Agenda of the selected day. -->
                <Border x:Name="AgendaBorder"
                        Grid.Row="3"
                        BorderBrush="{ThemeResource CalendarLineBrush}"
                        BorderThickness="0,1,0,0">
                  <Grid x:Name="AgendaHost">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="AgendaHeader" MinHeight="60" ColumnSpacing="12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="AgendaTitle"
                                 VerticalAlignment="Center"
                                 FontFamily="{StaticResource CalendarSemiBoldFontFamily}"
                                 FontSize="17"
                                 Foreground="{ThemeResource CalendarInkBrush}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock x:Name="AgendaSummary"
                                 Grid.Column="1"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Margin="0,2,0,0"
                                 Style="{StaticResource CalendarMutedTextStyle}" />
                      <Button x:Name="AddEventButton" Grid.Column="2" Style="{StaticResource CalendarAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Viewbox Width="18" Height="18">
                            <Path Data="M12,5 L12,19 M5,12 L19,12" Style="{StaticResource CalendarIconPathStyle}" StrokeThickness="2" Stroke="{ThemeResource CalendarOnAccentBrush}" />
                          </Viewbox>
                          <TextBlock Text="Add event" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </Grid>

                    <!-- Events -->
                    <ScrollViewer x:Name="EventsArea" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                      <Grid>
                        <ItemsControl x:Name="Rows" IsTabStop="False">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid Height="54" ColumnSpacing="16" BorderBrush="{ThemeResource CalendarLineBrush}" BorderThickness="0,1,0,0">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="84" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="132" />
                                  <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                  <TextBlock FontFamily="{StaticResource CalendarSemiBoldFontFamily}" FontSize="15" LineHeight="18" Foreground="{ThemeResource CalendarInkBrush}">
                                    <Run Text="{Binding Time}" />
                                    <Run Text="{Binding Meridiem}" FontSize="11" FontFamily="{StaticResource CalendarMediumFontFamily}" />
                                  </TextBlock>
                                  <TextBlock Text="{Binding Duration}" FontSize="12" LineHeight="16" Foreground="{ThemeResource CalendarMutedBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                  <TextBlock Text="{Binding Title}" Style="{StaticResource CalendarStrongTextStyle}" />
                                  <TextBlock Text="{Binding Detail}" Style="{StaticResource CalendarMutedTextStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Location}" Style="{StaticResource CalendarMutedTextStyle}" />
                                <Button Grid.Column="3"
                                        Style="{StaticResource CalendarGhostButtonStyle}"
                                        Command="{Binding OptionsCommand}"
                                        CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                        AutomationProperties.Name="{Binding OptionsName}">
                                  <Viewbox Width="20" Height="20">
                                    <Path Data="M4,12 A1,1 0 1 0 6,12 A1,1 0 1 0 4,12 M11,12 A1,1 0 1 0 13,12 A1,1 0 1 0 11,12 M18,12 A1,1 0 1 0 20,12 A1,1 0 1 0 18,12"
                                          Style="{StaticResource CalendarIconPathStyle}"
                                          Stroke="{ThemeResource CalendarInkBrush}" />
                                  </Viewbox>
                                </Button>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl x:Name="CompactRows" IsTabStop="False" Visibility="Collapsed">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Grid Height="64" ColumnSpacing="12" BorderBrush="{ThemeResource CalendarLineBrush}" BorderThickness="0,1,0,0">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="76" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                  <TextBlock FontFamily="{StaticResource CalendarSemiBoldFontFamily}" FontSize="15" LineHeight="18" Foreground="{ThemeResource CalendarInkBrush}">
                                    <Run Text="{Binding Time}" />
                                    <Run Text="{Binding Meridiem}" FontSize="11" FontFamily="{StaticResource CalendarMediumFontFamily}" />
                                  </TextBlock>
                                  <TextBlock Text="{Binding Duration}" FontSize="12" LineHeight="16" Foreground="{ThemeResource CalendarMutedBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                  <TextBlock Text="{Binding Title}" Style="{StaticResource CalendarStrongTextStyle}" />
                                  <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Viewbox Width="14" Height="14" VerticalAlignment="Center" Visibility="{Binding VideoIconVisibility}">
                                      <Path Data="M15,10 L19.553,7.724 A1,1 0 0 1 21,8.618 V15.382 A1,1 0 0 1 19.553,16.276 L15,14 Z M5,6 H13 A2,2 0 0 1 15,8 V16 A2,2 0 0 1 13,18 H5 A2,2 0 0 1 3,16 V8 A2,2 0 0 1 5,6 Z"
                                            Style="{StaticResource CalendarIconPathStyle}"
                                            Stroke="{ThemeResource CalendarMutedBrush}" />
                                    </Viewbox>
                                    <Viewbox Width="14" Height="14" VerticalAlignment="Center" Visibility="{Binding PlaceIconVisibility}">
                                      <Path Data="M9,11 A3,3 0 1 0 15,11 A3,3 0 1 0 9,11 M17.657,16.657 L13.414,20.9 A2,2 0 0 1 10.587,20.9 L6.343,16.657 A8,8 0 1 1 17.657,16.657 Z"
                                            Style="{StaticResource CalendarIconPathStyle}"
                                            Stroke="{ThemeResource CalendarMutedBrush}" />
                                    </Viewbox>
                                    <TextBlock Text="{Binding Location}" Style="{StaticResource CalendarMutedTextStyle}" />
                                  </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Width="44"
                                        Height="44"
                                        Style="{StaticResource CalendarGhostButtonStyle}"
                                        Command="{Binding OptionsCommand}"
                                        CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                        AutomationProperties.Name="{Binding OptionsName}">
                                  <Viewbox Width="20" Height="20">
                                    <Path Data="M4,12 A1,1 0 1 0 6,12 A1,1 0 1 0 4,12 M11,12 A1,1 0 1 0 13,12 A1,1 0 1 0 11,12 M18,12 A1,1 0 1 0 20,12 A1,1 0 1 0 18,12"
                                          Style="{StaticResource CalendarIconPathStyle}"
                                          Stroke="{ThemeResource CalendarInkBrush}" />
                                  </Viewbox>
                                </Button>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                    </ScrollViewer>

                    <!-- Empty day -->
                    <StackPanel x:Name="EmptyArea"
                                Grid.Row="1"
                                Padding="6,0"
                                VerticalAlignment="Center"
                                Spacing="6"
                                BorderBrush="{ThemeResource CalendarLineBrush}"
                                Visibility="Collapsed">
                      <TextBlock x:Name="EmptyTitle" Style="{StaticResource CalendarStrongTextStyle}" />
                      <TextBlock Text="The day is open. Add an event or pick another day." Style="{StaticResource CalendarMutedTextStyle}" TextWrapping="Wrap" />
                      <Button x:Name="EmptyAddEventButton" Margin="0,4,0,0" Style="{StaticResource CalendarSmallOutlineButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Viewbox Width="16" Height="16">
                            <Path Data="M12,5 L12,19 M5,12 L19,12" Style="{StaticResource CalendarIconPathStyle}" Stroke="{ThemeResource CalendarInkBrush}" />
                          </Viewbox>
                          <TextBlock Text="Add event" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </StackPanel>

                    <!-- Loading: three skeleton rows at the rows' height. -->
                    <Grid x:Name="LoadingArea" Grid.Row="1" Visibility="Collapsed" AutomationProperties.Name="Loading events">
                      <StackPanel x:Name="LoadingRows">
                        <Grid Height="54" ColumnSpacing="16" BorderBrush="{ThemeResource CalendarLineBrush}" BorderThickness="0,1,0,0">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="84" /><ColumnDefinition Width="72*" /><ColumnDefinition Width="28*" /></Grid.ColumnDefinitions>
                          <Border Width="40" Height="10" HorizontalAlignment="Left" CornerRadius="4" Background="{ThemeResource CalendarSkeletonBrush}" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                            <Border Height="10" CornerRadius="4" Background="{ThemeResource CalendarSkeletonBrush}" />
                            <Border Width="160" Height="8" HorizontalAlignment="Left" CornerRadius="4" Background="{ThemeResource CalendarSkeletonBrush}" />
                          </StackPanel>
                        </Grid>
                        <Grid Height="54" ColumnSpacing="16" BorderBrush="{ThemeResource CalendarLineBrush}" BorderThickness="0,1,0,0">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="84" /><ColumnDefinition Width="60*" /><ColumnDefinition Width="40*" /></Grid.ColumnDefinitions>
                          <Border Width="40" Height="10" HorizontalAlignment="Left" CornerRadius="4" Background="{ThemeResource CalendarSkeletonBrush}" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                            <Border Height="10" CornerRadius="4" Background="{ThemeResource CalendarSkeletonBrush}" />
                            <Border Width="120" Height="8" HorizontalAlignment="Left" CornerRadius="4" Background="{ThemeResource CalendarSkeletonBrush}" />
                          </StackPanel>
                        </Grid>
                        <Grid Height="54" ColumnSpacing="16" BorderBrush="{ThemeResource CalendarLineBrush}" BorderThickness="0,1,0,0">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="84" /><ColumnDefinition Width="66*" /><ColumnDefinition Width="34*" /></Grid.ColumnDefinitions>
                          <Border Width="40" Height="10" HorizontalAlignment="Left" CornerRadius="4" Background="{ThemeResource CalendarSkeletonBrush}" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                            <Border Height="10" CornerRadius="4" Background="{ThemeResource CalendarSkeletonBrush}" />
                            <Border Width="140" Height="8" HorizontalAlignment="Left" CornerRadius="4" Background="{ThemeResource CalendarSkeletonBrush}" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                      <StackPanel x:Name="CompactLoadingRows" Visibility="Collapsed">
                        <Grid Height="64" ColumnSpacing="12" BorderBrush="{ThemeResource CalendarLineBrush}" BorderThickness="0,1,0,0">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="72*" /><ColumnDefinition Width="28*" /></Grid.ColumnDefinitions>
                          <Border Width="40" Height="10" HorizontalAlignment="Left" CornerRadius="4" Background="{ThemeResource CalendarSkeletonBrush}" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                            <Border Height="10" CornerRadius="4" Background="{ThemeResource CalendarSkeletonBrush}" />
                            <Border Width="90" Height="8" HorizontalAlignment="Left" CornerRadius="4" Background="{ThemeResource CalendarSkeletonBrush}" />
                          </StackPanel>
                        </Grid>
                        <Grid Height="64" ColumnSpacing="12" BorderBrush="{ThemeResource CalendarLineBrush}" BorderThickness="0,1,0,0">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="60*" /><ColumnDefinition Width="40*" /></Grid.ColumnDefinitions>
                          <Border Width="40" Height="10" HorizontalAlignment="Left" CornerRadius="4" Background="{ThemeResource CalendarSkeletonBrush}" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                            <Border Height="10" CornerRadius="4" Background="{ThemeResource CalendarSkeletonBrush}" />
                            <Border Width="70" Height="8" HorizontalAlignment="Left" CornerRadius="4" Background="{ThemeResource CalendarSkeletonBrush}" />
                          </StackPanel>
                        </Grid>
                        <Grid Height="64" ColumnSpacing="12" BorderBrush="{ThemeResource CalendarLineBrush}" BorderThickness="0,1,0,0">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="66*" /><ColumnDefinition Width="34*" /></Grid.ColumnDefinitions>
                          <Border Width="40" Height="10" HorizontalAlignment="Left" CornerRadius="4" Background="{ThemeResource CalendarSkeletonBrush}" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                            <Border Height="10" CornerRadius="4" Background="{ThemeResource CalendarSkeletonBrush}" />
                            <Border Width="80" Height="8" HorizontalAlignment="Left" CornerRadius="4" Background="{ThemeResource CalendarSkeletonBrush}" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Grid>

                    <!-- Load error: only the agenda is replaced. -->
                    <StackPanel x:Name="ErrorArea"
                                Grid.Row="1"
                                Padding="6,0"
                                VerticalAlignment="Center"
                                Spacing="6"
                                Visibility="Collapsed">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                          <Path Data="M12,18 L12.01,18 M9.172,15.172 A4,4 0 0 1 14.828,15.172 M6.343,12.343 A7.963,7.963 0 0 1 10.207,10.203 M14.37,10.358 A7.965,7.965 0 0 1 17.657,12.358 M3.515,9.515 A12,12 0 0 1 6.984,7.165 M10.06,6.136 A12,12 0 0 1 20.485,9.515 M3,3 L21,21"
                                Style="{StaticResource CalendarIconPathStyle}"
                                Stroke="{ThemeResource CalendarInkBrush}" />
                        </Viewbox>
                        <TextBlock x:Name="ErrorTitleText"
                                   Text="{TemplateBinding ErrorTitle}"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CalendarStrongTextStyle}"
                                   AutomationProperties.LiveSetting="Assertive" />
                      </StackPanel>
                      <TextBlock Text="{TemplateBinding ErrorMessage}" Style="{StaticResource CalendarMutedTextStyle}" TextWrapping="Wrap" />
                      <Button x:Name="RetryButton" Margin="0,4,0,0" Style="{StaticResource CalendarSmallOutlineButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Viewbox Width="16" Height="16">
                            <Path Data="M20,11 A8.1,8.1 0 0 0 4.5,9 M4,5 L4,9 L8,9 M4,13 A8.1,8.1 0 0 0 19.5,15 M20,19 L20,15 L16,15"
                                  Style="{StaticResource CalendarIconPathStyle}"
                                  Stroke="{ThemeResource CalendarInkBrush}" />
                          </Viewbox>
                          <TextBlock Text="Retry" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- Phones: "Add event" docked under the agenda. -->
                <Border x:Name="CompactDock"
                        Grid.Row="4"
                        Margin="0,12,0,0"
                        Padding="0,12,0,0"
                        BorderBrush="{ThemeResource CalendarLineBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="Collapsed">
                  <Button x:Name="CompactAddEventButton"
                          Height="48"
                          HorizontalAlignment="Stretch"
                          CornerRadius="24"
                          FontSize="15"
                          Style="{StaticResource CalendarAccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Viewbox Width="18" Height="18">
                        <Path Data="M12,5 L12,19 M5,12 L19,12" Style="{StaticResource CalendarIconPathStyle}" StrokeThickness="2" Stroke="{ThemeResource CalendarOnAccentBrush}" />
                      </Viewbox>
                      <TextBlock Text="Add event" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
