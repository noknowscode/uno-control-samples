<!--
    RadialActionMenu and RadialActionMenuItem: default styles, templates and tokens.
    Colours alias the palette (Styles/ColorPaletteOverride.xaml) where a Material role fits: the trigger is Primary
    (the accent), icons and text OnSurface (ink), the key badge OnSurfaceVariant on an OutlineVariant hairline, the
    disc edge Outline. The chip white, the dotted guide and the scrim have no role, so they are tokens here.
    Merge after MaterialToolkitTheme.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utu="using:Uno.Toolkit.UI"
                    xmlns:controls="using:RadialActionMenuDemo.Controls">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="RadialMenuChipBrush" Color="#FBFAF7" />
      <SolidColorBrush x:Key="RadialMenuChipHoverBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="RadialMenuGuideBrush" Color="#8E897F" />
      <SolidColorBrush x:Key="RadialMenuScrimBrush" Color="#57252422" />
      <SolidColorBrush x:Key="RadialMenuTriggerHoverBrush" Color="#0D000000" />
      <SolidColorBrush x:Key="RadialMenuReadoutKeyBrush" Color="#66FBFAF7" />
      <x:Double x:Key="RadialMenuShadowOpacity">0.55</x:Double>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="RadialMenuChipBrush" Color="#33312D" />
      <SolidColorBrush x:Key="RadialMenuChipHoverBrush" Color="#3D3A35" />
      <SolidColorBrush x:Key="RadialMenuGuideBrush" Color="#77726A" />
      <SolidColorBrush x:Key="RadialMenuScrimBrush" Color="#73000000" />
      <SolidColorBrush x:Key="RadialMenuTriggerHoverBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="RadialMenuReadoutKeyBrush" Color="#66252422" />
      <x:Double x:Key="RadialMenuShadowOpacity">0.8</x:Double>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <RadialGradientBrush x:Key="RadialMenuDiscShadowBrush">
    <GradientStop Color="#55252422" Offset="0" />
    <GradientStop Color="#00252422" Offset="1" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="RadialMenuTriggerShadowBrush">
    <GradientStop Color="#9978280A" Offset="0" />
    <GradientStop Color="#0078280A" Offset="1" />
  </RadialGradientBrush>

  <!-- Key badge: 20 px, 5 px radius, hairline, 11 px SemiBold. -->
  <Style x:Key="RadialMenuKeyStyle" TargetType="Border">
    <Setter Property="MinWidth" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
    <Setter Property="Background" Value="{ThemeResource RadialMenuChipBrush}" />
  </Style>
  <Style x:Key="RadialMenuKeyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelSmall}">
    <Setter Property="CharacterSpacing" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style TargetType="controls:RadialActionMenuItem">
    <Setter Property="Background" Value="{ThemeResource RadialMenuChipBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:RadialActionMenuItem">
          <!-- Disc in the centre cell; the label pill moves to the cell beside it (left, right, above, below). The
               padding keeps the focus ring, badge and pill inside the item's bounds. -->
          <Grid x:Name="Root" Background="Transparent" Padding="6">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="PART_Disc"
                  Grid.Row="1" Grid.Column="1"
                  Width="{TemplateBinding DiscSize}"
                  Height="{TemplateBinding DiscSize}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
              <!-- Focus ring: 2 px ink, 3 px out from the disc. -->
              <Ellipse x:Name="FocusRing"
                       Margin="-5"
                       Stroke="{ThemeResource OnSurfaceBrush}"
                       StrokeThickness="2"
                       Opacity="0" />
<!-- Soft drop shadow (0 8 16 -10): a radial-gradient ellipse below the disc. The Toolkit ShadowContainer
                   left stale pixels on Skia when the item's focus look changed, so it is not used here. -->
              <Ellipse Margin="4,10,4,-6" Fill="{StaticResource RadialMenuDiscShadowBrush}" IsHitTestVisible="False" />
              <Grid x:Name="DiscShadow">                <Ellipse x:Name="Disc"
                         Width="{TemplateBinding DiscSize}"
                         Height="{TemplateBinding DiscSize}"
                         Fill="{TemplateBinding Background}"
                         Stroke="{TemplateBinding BorderBrush}"
                         StrokeThickness="1" /></Grid>
              <Viewbox x:Name="IconBox"
                       Width="{TemplateBinding IconSize}"
                       Height="{TemplateBinding IconSize}">
                <Path x:Name="Icon"
                      Width="24" Height="24"
                      Data="{TemplateBinding IconData}"
                      Stroke="{TemplateBinding Foreground}"
                      StrokeThickness="1.75"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
              </Viewbox>

              <!-- Touch layout: the key badge on the disc's top-left corner. -->
              <Border x:Name="Badge"
                      Style="{StaticResource RadialMenuKeyStyle}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="-5,-5,0,0"
                      Visibility="Collapsed">
                <TextBlock Text="{TemplateBinding KeyLabel}" Style="{StaticResource RadialMenuKeyTextStyle}" />
              </Border>
            </Grid>

            <!-- Pointer layout: a 30 px label pill with its key, 10 px from the disc. -->
            <Border x:Name="PART_LabelPill"
                    Grid.Row="1" Grid.Column="0"
                    Margin="0,0,10,0"
                    Height="30"
                    Padding="10,0,6,0"
                    CornerRadius="8"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource RadialMenuChipBrush}">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="PillText"
                           Text="{TemplateBinding Label}"
                           Style="{StaticResource LabelLarge}" CharacterSpacing="0"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource OnSurfaceBrush}"
                           VerticalAlignment="Center" />
                <Border x:Name="PillKey" Style="{StaticResource RadialMenuKeyStyle}">
                  <TextBlock x:Name="PillKeyText" Text="{TemplateBinding KeyLabel}" Style="{StaticResource RadialMenuKeyTextStyle}" />
                </Border>
              </StackPanel>
            </Border>

            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Disc.Fill" Value="{ThemeResource RadialMenuChipHoverBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Disc.Fill" Value="{ThemeResource OnSurfaceBrush}" />
                    <Setter Target="Disc.Stroke" Value="{ThemeResource OnSurfaceBrush}" />
                    <Setter Target="Icon.Stroke" Value="{ThemeResource RadialMenuChipBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <!-- Unavailable: the disc at 40%, the badge at 50%. -->
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="DiscShadow.Opacity" Value="0.4" />
                    <Setter Target="IconBox.Opacity" Value="0.4" />
                    <Setter Target="Badge.Opacity" Value="0.5" />
                    <Setter Target="PART_LabelPill.Opacity" Value="0.5" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>

              <!-- Keyboard focus: ring on the disc, the pill turns ink with chip text. Driven by the item from
                   GotFocus/LostFocus (a group of its own, so Button's FocusStates cannot leave it stale). -->
              <VisualStateGroup x:Name="KeyboardFocusStates">
                <VisualState x:Name="NotKeyboardFocused" />
                <VisualState x:Name="KeyboardFocused">
                  <VisualState.Setters>
                    <Setter Target="FocusRing.Opacity" Value="1" />
                    <Setter Target="PART_LabelPill.Background" Value="{ThemeResource OnSurfaceBrush}" />
                    <Setter Target="PillText.Foreground" Value="{ThemeResource RadialMenuChipBrush}" />
                    <Setter Target="PillKey.Background" Value="Transparent" />
                    <Setter Target="PillKey.BorderBrush" Value="{ThemeResource RadialMenuReadoutKeyBrush}" />
                    <Setter Target="PillKeyText.Foreground" Value="{ThemeResource RadialMenuChipBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>

              <VisualStateGroup x:Name="LabelStates">
                <VisualState x:Name="LabelLeft" />
                <VisualState x:Name="LabelRight">
                  <VisualState.Setters>
                    <Setter Target="PART_LabelPill.(Grid.Column)" Value="2" />
                    <Setter Target="PART_LabelPill.Margin" Value="10,0,0,0" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="LabelAbove">
                  <VisualState.Setters>
                    <Setter Target="PART_LabelPill.(Grid.Row)" Value="0" />
                    <Setter Target="PART_LabelPill.(Grid.Column)" Value="1" />
                    <Setter Target="PART_LabelPill.Margin" Value="0,0,0,10" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="LabelBelow">
                  <VisualState.Setters>
                    <Setter Target="PART_LabelPill.(Grid.Row)" Value="2" />
                    <Setter Target="PART_LabelPill.(Grid.Column)" Value="1" />
                    <Setter Target="PART_LabelPill.Margin" Value="0,10,0,0" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="BadgeOnly">
                  <VisualState.Setters>
                    <Setter Target="PART_LabelPill.Visibility" Value="Collapsed" />
                    <Setter Target="Badge.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>

              <!-- A finger sliding from the trigger is over this item: filled with ink. -->
              <VisualStateGroup x:Name="HighlightStates">
                <VisualState x:Name="NotHighlighted" />
                <VisualState x:Name="Highlighted">
                  <VisualState.Setters>
                    <Setter Target="Disc.Fill" Value="{ThemeResource OnSurfaceBrush}" />
                    <Setter Target="Disc.Stroke" Value="{ThemeResource OnSurfaceBrush}" />
                    <Setter Target="Icon.Stroke" Value="{ThemeResource RadialMenuChipBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The trigger: a round accent button, white plus that turns 45° into a close icon. -->
  <Style x:Key="RadialMenuTriggerStyle" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnPrimaryBrush}" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="PressScale" />
            </Grid.RenderTransform>
            <Ellipse x:Name="FocusRing" Margin="-5" Stroke="{ThemeResource OnSurfaceBrush}" StrokeThickness="2" Opacity="0" />
            <!-- Accent drop shadow (0 10 22 -10, rust at 70%) as a radial gradient. -->
            <Ellipse Margin="4,12,4,-8" Fill="{StaticResource RadialMenuTriggerShadowBrush}" IsHitTestVisible="False" />
            <Grid>
              <Ellipse Fill="{TemplateBinding Background}" />
              <Ellipse x:Name="HoverLayer" Fill="{ThemeResource RadialMenuTriggerHoverBrush}" Opacity="0" />
            </Grid>
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="HoverLayer.Opacity" Value="1" />
                    <Setter Target="PressScale.ScaleX" Value="0.96" />
                    <Setter Target="PressScale.ScaleY" Value="0.96" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Unfocused" />
                <VisualState x:Name="PointerFocused" />
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="FocusRing.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="controls:RadialActionMenu">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="AutomationProperties.Name" Value="Quick actions" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:RadialActionMenu">
          <Grid>
            <!-- Scrim over the content while open (34% ink, 220 ms); tapping it closes the menu. -->
            <Border x:Name="PART_Scrim"
                    Background="{ThemeResource RadialMenuScrimBrush}"
                    Opacity="0"
                    IsHitTestVisible="False" />

            <Canvas x:Name="PART_Canvas">
              <Path x:Name="PART_Guide"
                    Stroke="{ThemeResource RadialMenuGuideBrush}"
                    StrokeThickness="1.5"
                    StrokeDashArray="0.01,5.33"
                    StrokeDashCap="Round"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    Opacity="0"
                    IsHitTestVisible="False" />

              <!-- Items are inserted here, after the guide, by the control. -->

              <!-- Touch readout: "2  Email · release to open" while a finger is over an item. -->
              <Border x:Name="PART_Readout"
                      Height="40"
                      Padding="10,0,14,0"
                      CornerRadius="12"
                      Background="{ThemeResource OnSurfaceBrush}"
                      Opacity="0"
                      IsHitTestVisible="False"
                      AutomationProperties.LiveSetting="Polite">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <Border Style="{StaticResource RadialMenuKeyStyle}"
                          Background="Transparent"
                          BorderBrush="{ThemeResource RadialMenuReadoutKeyBrush}">
                    <TextBlock Text="{Binding HighlightedKey, RelativeSource={RelativeSource TemplatedParent}}"
                               Style="{StaticResource RadialMenuKeyTextStyle}"
                               Foreground="{ThemeResource RadialMenuChipBrush}" />
                  </Border>
                  <TextBlock VerticalAlignment="Center"
                             Style="{StaticResource BodyLarge}" CharacterSpacing="0"
                             FontSize="15"
                             Foreground="{ThemeResource RadialMenuChipBrush}">
                    <Run FontWeight="SemiBold" Text="{Binding HighlightedLabel, RelativeSource={RelativeSource TemplatedParent}}" />
                    <Run Text=" · release to open" Foreground="{ThemeResource RadialMenuGuideBrush}" />
                  </TextBlock>
                </StackPanel>
              </Border>

              <!-- Hint beside the closed trigger on hover or keyboard focus. -->
              <Border x:Name="PART_Hint"
                      Padding="10,7"
                      CornerRadius="8"
                      Background="{ThemeResource OnSurfaceBrush}"
                      Opacity="0"
                      IsHitTestVisible="False">
                <TextBlock Style="{StaticResource LabelMedium}" CharacterSpacing="0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource SurfaceBrush}">
                  <Run Text="{Binding TriggerLabel, RelativeSource={RelativeSource TemplatedParent}}" />
                  <Run Text=" Space" Foreground="{ThemeResource RadialMenuGuideBrush}" />
                </TextBlock>
              </Border>

              <Button x:Name="PART_Trigger"
                      Canvas.ZIndex="1"
                      Style="{StaticResource RadialMenuTriggerStyle}">
                <Viewbox Width="26" Height="26" RenderTransformOrigin="0.5,0.5">
                  <Viewbox.RenderTransform>
                    <RotateTransform x:Name="PART_PlusRotation" />
                  </Viewbox.RenderTransform>
                  <Path Width="24" Height="24"
                        Data="M12 5l0 14 M5 12l14 0"
                        Stroke="{ThemeResource OnPrimaryBrush}"
                        StrokeThickness="1.75"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round" />
                </Viewbox>
              </Button>
            </Canvas>

            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="OpenStates">
                <VisualState x:Name="Closed" />
                <VisualState x:Name="Open" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="HintStates">
                <VisualState x:Name="HintHidden" />
                <VisualState x:Name="HintVisible">
                  <VisualState.Setters>
                    <Setter Target="PART_Hint.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="SlideStates">
                <VisualState x:Name="NotSliding" />
                <VisualState x:Name="Sliding">
                  <VisualState.Setters>
                    <Setter Target="PART_Readout.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
