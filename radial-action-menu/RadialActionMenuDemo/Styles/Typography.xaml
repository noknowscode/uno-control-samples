<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Headings: Archivo Bold Expanded, a static instance (weight 700, width 112) of the variable font. -->
  <FontFamily x:Key="DisplayFontFamily">ms-appx:///Assets/Fonts/ArchivoExpanded-Bold.ttf</FontFamily>

  <!-- The panel title: 26 px (32 px on a phone, set on the page through utu:Responsive). -->
  <Style x:Key="DisplayTitle" TargetType="TextBlock" BasedOn="{StaticResource HeadlineSmall}">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="LineHeight" Value="32" />
    <Setter Property="CharacterSpacing" Value="-10" />
  </Style>

</ResourceDictionary>
