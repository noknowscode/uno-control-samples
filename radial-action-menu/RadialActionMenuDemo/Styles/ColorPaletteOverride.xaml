<!--
    The palette: the one place this sample's colours live. MaterialToolkitTheme reads it through ColorOverrideSource
    (App.xaml) and generates every role brush from it. Uno Platform Studio's Themes tab edits this file.
    Light is the design's palette: ground #DCD9D2, surface #ECEAE5, ink #252422, muted #55524C, hairline #BDB8AE,
    disc edge #7F7A70, avatar #CFCBC2, accent #CC4A14 (Primary, the trigger).
    Dark keeps the warm greys and the same accent on a near-black ground.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="PrimaryColor">#CC4A14</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
      <Color x:Key="PrimaryContainerColor">#FFDBCD</Color>
      <Color x:Key="OnPrimaryContainerColor">#380D00</Color>
      <Color x:Key="SecondaryColor">#55524C</Color>
      <Color x:Key="OnSecondaryColor">#FFFFFF</Color>
      <Color x:Key="SecondaryContainerColor">#E3DFD7</Color>
      <Color x:Key="OnSecondaryContainerColor">#252422</Color>
      <Color x:Key="TertiaryColor">#2F6B4F</Color>
      <Color x:Key="OnTertiaryColor">#FFFFFF</Color>
      <Color x:Key="TertiaryContainerColor">#B3F0CF</Color>
      <Color x:Key="OnTertiaryContainerColor">#002113</Color>
      <Color x:Key="ErrorColor">#B3261E</Color>
      <Color x:Key="OnErrorColor">#FFFFFF</Color>
      <Color x:Key="ErrorContainerColor">#F9DEDC</Color>
      <Color x:Key="OnErrorContainerColor">#410E0B</Color>
      <Color x:Key="BackgroundColor">#DCD9D2</Color>
      <Color x:Key="OnBackgroundColor">#252422</Color>
      <Color x:Key="SurfaceColor">#ECEAE5</Color>
      <Color x:Key="OnSurfaceColor">#252422</Color>
      <Color x:Key="SurfaceVariantColor">#CFCBC2</Color>
      <Color x:Key="OnSurfaceVariantColor">#55524C</Color>
      <Color x:Key="OutlineColor">#7F7A70</Color>
      <Color x:Key="OutlineVariantColor">#BDB8AE</Color>
      <Color x:Key="SurfaceInverseColor">#252422</Color>
      <Color x:Key="OnSurfaceInverseColor">#FBFAF7</Color>
      <Color x:Key="PrimaryInverseColor">#FFB59A</Color>
      <Color x:Key="SurfaceTintColor">#CC4A14</Color>
      <Color x:Key="ShadowColor">#33252422</Color>
      <Color x:Key="PrimaryVariantDarkColor">#A33A0E</Color>
      <Color x:Key="PrimaryVariantLightColor">#FFDBCD</Color>
      <Color x:Key="SecondaryVariantDarkColor">#3D3A35</Color>
      <Color x:Key="SecondaryVariantLightColor">#E3DFD7</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <Color x:Key="PrimaryColor">#CC4A14</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
      <Color x:Key="PrimaryContainerColor">#7A2A08</Color>
      <Color x:Key="OnPrimaryContainerColor">#FFDBCD</Color>
      <Color x:Key="SecondaryColor">#ADA89E</Color>
      <Color x:Key="OnSecondaryColor">#252422</Color>
      <Color x:Key="SecondaryContainerColor">#3E3B36</Color>
      <Color x:Key="OnSecondaryContainerColor">#ECEAE5</Color>
      <Color x:Key="TertiaryColor">#97D4B3</Color>
      <Color x:Key="OnTertiaryColor">#003822</Color>
      <Color x:Key="TertiaryContainerColor">#145239</Color>
      <Color x:Key="OnTertiaryContainerColor">#B3F0CF</Color>
      <Color x:Key="ErrorColor">#FFB4AB</Color>
      <Color x:Key="OnErrorColor">#690005</Color>
      <Color x:Key="ErrorContainerColor">#93000A</Color>
      <Color x:Key="OnErrorContainerColor">#FFDAD6</Color>
      <Color x:Key="BackgroundColor">#171614</Color>
      <Color x:Key="OnBackgroundColor">#ECEAE5</Color>
      <Color x:Key="SurfaceColor">#21201D</Color>
      <Color x:Key="OnSurfaceColor">#ECEAE5</Color>
      <Color x:Key="SurfaceVariantColor">#34322E</Color>
      <Color x:Key="OnSurfaceVariantColor">#ADA89E</Color>
      <Color x:Key="OutlineColor">#8A857B</Color>
      <Color x:Key="OutlineVariantColor">#3E3B36</Color>
      <Color x:Key="SurfaceInverseColor">#ECEAE5</Color>
      <Color x:Key="OnSurfaceInverseColor">#252422</Color>
      <Color x:Key="PrimaryInverseColor">#CC4A14</Color>
      <Color x:Key="SurfaceTintColor">#CC4A14</Color>
      <Color x:Key="ShadowColor">#66000000</Color>
      <Color x:Key="PrimaryVariantDarkColor">#A33A0E</Color>
      <Color x:Key="PrimaryVariantLightColor">#7A2A08</Color>
      <Color x:Key="SecondaryVariantDarkColor">#ADA89E</Color>
      <Color x:Key="SecondaryVariantLightColor">#3E3B36</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
