<!--
    Font override (MaterialToolkitTheme FontOverrideSource): Geist for text, Geist Mono for numbers, as in the
    prototype. Static TTFs cut from the prototype's variable fonts (Skia renders a variable font's default instance
    only); the #fragment is each file's internal family name. Licences: Assets/Fonts/Geist/OFL.txt and
    Assets/Fonts/GeistMono/OFL.txt. The chart's SkiaSharp labels load the same files (LivelineChartCanvas).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Uno.Themes: every type-scale family derives from DefaultFontFamily. Skia renders one weight per file, so the
       scales Material sets in Medium point at the Medium file. -->
  <FontFamily x:Key="DefaultFontFamily">ms-appx:///Assets/Fonts/Geist/Geist-Regular.ttf#Geist</FontFamily>
  <FontFamily x:Key="TitleMediumFontFamily">ms-appx:///Assets/Fonts/Geist/Geist-Medium.ttf#Geist Medium</FontFamily>
  <FontFamily x:Key="TitleSmallFontFamily">ms-appx:///Assets/Fonts/Geist/Geist-Medium.ttf#Geist Medium</FontFamily>
  <FontFamily x:Key="LabelLargeFontFamily">ms-appx:///Assets/Fonts/Geist/Geist-Medium.ttf#Geist Medium</FontFamily>
  <FontFamily x:Key="LabelMediumFontFamily">ms-appx:///Assets/Fonts/Geist/Geist-Medium.ttf#Geist Medium</FontFamily>
  <FontFamily x:Key="LabelSmallFontFamily">ms-appx:///Assets/Fonts/Geist/Geist-Medium.ttf#Geist Medium</FontFamily>
  <FontFamily x:Key="LabelExtraSmallFontFamily">ms-appx:///Assets/Fonts/Geist/Geist-Medium.ttf#Geist Medium</FontFamily>

  <!-- The same files under app keys, for templates that need a given weight. -->
  <FontFamily x:Key="UiRegularFontFamily">ms-appx:///Assets/Fonts/Geist/Geist-Regular.ttf#Geist</FontFamily>
  <FontFamily x:Key="UiMediumFontFamily">ms-appx:///Assets/Fonts/Geist/Geist-Medium.ttf#Geist Medium</FontFamily>
  <FontFamily x:Key="UiSemiBoldFontFamily">ms-appx:///Assets/Fonts/Geist/Geist-SemiBold.ttf#Geist SemiBold</FontFamily>
  <FontFamily x:Key="MonoRegularFontFamily">ms-appx:///Assets/Fonts/GeistMono/GeistMono-Regular.ttf#Geist Mono</FontFamily>
  <FontFamily x:Key="MonoMediumFontFamily">ms-appx:///Assets/Fonts/GeistMono/GeistMono-Medium.ttf#Geist Mono Medium</FontFamily>
</ResourceDictionary>
