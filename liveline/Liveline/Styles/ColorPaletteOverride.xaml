<!--
    The palette: the one place this sample's colours live. MaterialToolkitTheme reads it through ColorOverrideSource
    (App.xaml); Uno Platform Studio's Themes tab edits this file.

    Light is the prototype sheet's palette, exactly:
      Background        #EEF2EC  page (bg)            Surface           #F8FAF6  card (surface)
      OnSurface         #11251B  ink (ink)            OnSurfaceVariant  #4E6356  muted (muted)
      OutlineVariant    #D2DBD0  hairlines (line)     Outline           #7E8F83  control outlines (ctl)
      Primary           #11805A  line, live dot (accent)
      SurfaceVariant    #E4EBE2  hover plate
    The grid line (#DCE4DA) has no Material role: LivelineGridBrush in Controls/Liveline/LivelineChart.xaml.
    Secondary and Tertiary carry the prototype's other accent options (#11251B ink, #1F6FB2 blue).
    Dark keeps the same green-grey ladder, inverted. All 33 roles are set in both themes.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="PrimaryColor">#11805A</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
      <Color x:Key="PrimaryContainerColor">#CDEBDD</Color>
      <Color x:Key="OnPrimaryContainerColor">#002116</Color>
      <Color x:Key="SecondaryColor">#11251B</Color>
      <Color x:Key="OnSecondaryColor">#FFFFFF</Color>
      <Color x:Key="SecondaryContainerColor">#D2DBD0</Color>
      <Color x:Key="OnSecondaryContainerColor">#11251B</Color>
      <Color x:Key="TertiaryColor">#1F6FB2</Color>
      <Color x:Key="OnTertiaryColor">#FFFFFF</Color>
      <Color x:Key="TertiaryContainerColor">#D3E4FF</Color>
      <Color x:Key="OnTertiaryContainerColor">#001C38</Color>
      <Color x:Key="ErrorColor">#B3261E</Color>
      <Color x:Key="OnErrorColor">#FFFFFF</Color>
      <Color x:Key="ErrorContainerColor">#F9DEDC</Color>
      <Color x:Key="OnErrorContainerColor">#410E0B</Color>
      <Color x:Key="BackgroundColor">#EEF2EC</Color>
      <Color x:Key="OnBackgroundColor">#11251B</Color>
      <Color x:Key="SurfaceColor">#F8FAF6</Color>
      <Color x:Key="OnSurfaceColor">#11251B</Color>
      <Color x:Key="SurfaceVariantColor">#E4EBE2</Color>
      <Color x:Key="OnSurfaceVariantColor">#4E6356</Color>
      <Color x:Key="OutlineColor">#7E8F83</Color>
      <Color x:Key="OutlineVariantColor">#D2DBD0</Color>
      <Color x:Key="SurfaceInverseColor">#11251B</Color>
      <Color x:Key="OnSurfaceInverseColor">#EEF2EC</Color>
      <Color x:Key="PrimaryInverseColor">#6FD3A6</Color>
      <Color x:Key="SurfaceTintColor">#11805A</Color>
      <Color x:Key="ShadowColor">#000000</Color>
      <Color x:Key="PrimaryVariantDarkColor">#00563B</Color>
      <Color x:Key="PrimaryVariantLightColor">#CDEBDD</Color>
      <Color x:Key="SecondaryVariantDarkColor">#000000</Color>
      <Color x:Key="SecondaryVariantLightColor">#D2DBD0</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <Color x:Key="PrimaryColor">#4CC793</Color>
      <Color x:Key="OnPrimaryColor">#00382A</Color>
      <Color x:Key="PrimaryContainerColor">#00513C</Color>
      <Color x:Key="OnPrimaryContainerColor">#B8F0D6</Color>
      <Color x:Key="SecondaryColor">#E1EAE3</Color>
      <Color x:Key="OnSecondaryColor">#11251B</Color>
      <Color x:Key="SecondaryContainerColor">#2C3D33</Color>
      <Color x:Key="OnSecondaryContainerColor">#E1EAE3</Color>
      <Color x:Key="TertiaryColor">#9FCAFF</Color>
      <Color x:Key="OnTertiaryColor">#003258</Color>
      <Color x:Key="TertiaryContainerColor">#00497D</Color>
      <Color x:Key="OnTertiaryContainerColor">#D3E4FF</Color>
      <Color x:Key="ErrorColor">#F2B8B5</Color>
      <Color x:Key="OnErrorColor">#601410</Color>
      <Color x:Key="ErrorContainerColor">#8C1D18</Color>
      <Color x:Key="OnErrorContainerColor">#F9DEDC</Color>
      <Color x:Key="BackgroundColor">#0D1712</Color>
      <Color x:Key="OnBackgroundColor">#E1EAE3</Color>
      <Color x:Key="SurfaceColor">#131F18</Color>
      <Color x:Key="OnSurfaceColor">#E1EAE3</Color>
      <Color x:Key="SurfaceVariantColor">#1D2B23</Color>
      <Color x:Key="OnSurfaceVariantColor">#9DB0A3</Color>
      <Color x:Key="OutlineColor">#62766A</Color>
      <Color x:Key="OutlineVariantColor">#2A3A31</Color>
      <Color x:Key="SurfaceInverseColor">#E1EAE3</Color>
      <Color x:Key="OnSurfaceInverseColor">#11251B</Color>
      <Color x:Key="PrimaryInverseColor">#11805A</Color>
      <Color x:Key="SurfaceTintColor">#4CC793</Color>
      <Color x:Key="ShadowColor">#000000</Color>
      <Color x:Key="PrimaryVariantDarkColor">#2FA877</Color>
      <Color x:Key="PrimaryVariantLightColor">#B8F0D6</Color>
      <Color x:Key="SecondaryVariantDarkColor">#B9C6BD</Color>
      <Color x:Key="SecondaryVariantLightColor">#F4F8F5</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
