<Application x:Class="Liveline.Demo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utum="using:Uno.Toolkit.UI.Material">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <!-- Material with the Toolkit. The palette (Styles/ColorPaletteOverride.xaml) is the one place colours live;
             Studio's Themes tab edits it. The font override sets Geist and Geist Mono. -->
        <utum:MaterialToolkitTheme
          ColorOverrideSource="ms-appx:///Styles/ColorPaletteOverride.xaml"
          FontOverrideSource="ms-appx:///Styles/MaterialFontsOverride.xaml" />

        <ResourceDictionary Source="ms-appx:///Themes/Generic.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
