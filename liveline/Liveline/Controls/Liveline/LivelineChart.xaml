<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:Liveline">

  <!--
    LivelineChart's default style: the prototype's live card. Colours are palette roles from
    Styles/ColorPaletteOverride.xaml, plus one control token with no Material role (the grid line):
      Background   SurfaceBrush           card (#F8FAF6)          BorderBrush  OutlineVariantBrush  hairlines (#D2DBD0)
      Foreground   OnSurfaceBrush         ink (#11251B)           MutedBrush   OnSurfaceVariantBrush (#4E6356)
      AccentBrush  PrimaryBrush           line and live dot (#11805A)
      GridBrush    LivelineGridBrush      grid lines, gap hatching (#DCE4DA)
      OutlineBrush                         control outlines (#7E8F83); SurfaceVariantBrush hover plate (#E4EBE2)
    Type: Geist for text, Geist Mono for numbers (Styles/MaterialFontsOverride.xaml).
    Layout: Regular, and Compact below LivelineChart.CompactWidth (560 px of card width): chart first, controls low.
  -->

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="LivelineGridBrush" Color="#DCE4DA" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="LivelineGridBrush" Color="#22322A" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Segment of the window selector: 13 px medium, 14 px radius inside a 4 px-padded outline; the checked one is an ink plate. -->
  <Style x:Key="LivelineSegmentStyle" TargetType="RadioButton">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="FontFamily" Value="{StaticResource UiMediumFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid x:Name="Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Hover.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Hover.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Indeterminate" />
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Plate.Opacity" Value="1" />
                    <Setter Target="Label.Foreground" Value="{ThemeResource BackgroundBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Hover" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource SurfaceVariantBrush}" Opacity="0" />
            <Border x:Name="Plate" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource OnSurfaceBrush}" Opacity="0" />
            <ContentPresenter x:Name="Label"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Outlined round and pill buttons (pause, reconnect): outline OutlineBrush, hover plate, press to 96%. -->
  <Style x:Key="LivelineOutlineButtonStyle" TargetType="Button">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiMediumFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="Press" />
            </Grid.RenderTransform>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver">
                  <VisualState.Setters>
                    <Setter Target="Plate.Background" Value="{ThemeResource SurfaceVariantBrush}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Plate.Background" Value="{ThemeResource SurfaceVariantBrush}" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.12" />
                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.12" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Root.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Plate"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Content}"
                              Foreground="{TemplateBinding Foreground}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="LivelineStatLabelStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiRegularFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
  </Style>

  <Style x:Key="LivelineStatValueStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoRegularFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
  </Style>

  <Style TargetType="local:LivelineChart">
    <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Padding" Value="24,20,24,16" />
    <Setter Property="AccentBrush" Value="{ThemeResource PrimaryBrush}" />
    <Setter Property="MutedBrush" Value="{ThemeResource OnSurfaceVariantBrush}" />
    <Setter Property="GridBrush" Value="{ThemeResource LivelineGridBrush}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="MinHeight" Value="320" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:LivelineChart">
          <Border x:Name="Card"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="StreamStates">
                <VisualState x:Name="Connecting">
                  <VisualState.Setters>
                    <Setter Target="StatusDot.Fill" Value="Transparent" />
                    <Setter Target="StatusDot.Stroke" Value="{ThemeResource OnSurfaceVariantBrush}" />
                    <Setter Target="StatusLabel.Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
                    <Setter Target="ValueRow.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Live" />
                <VisualState x:Name="Pausing" />
                <VisualState x:Name="Paused">
                  <VisualState.Setters>
                    <Setter Target="StatusDot.Fill" Value="Transparent" />
                    <Setter Target="StatusDot.Stroke" Value="{ThemeResource OnSurfaceVariantBrush}" />
                    <Setter Target="StatusLabel.Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
                    <Setter Target="PauseIcon.Visibility" Value="Collapsed" />
                    <Setter Target="PlayIcon.Visibility" Value="Visible" />
                    <Setter Target="CompactPauseIcon.Visibility" Value="Collapsed" />
                    <Setter Target="CompactPlayIcon.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disconnected">
                  <VisualState.Setters>
                    <Setter Target="StatusDot.Fill" Value="Transparent" />
                    <Setter Target="StatusDot.Stroke" Value="{ThemeResource OnSurfaceVariantBrush}" />
                    <Setter Target="StatusLabel.Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
                    <Setter Target="PART_ReconnectButton.Visibility" Value="Visible" />
                    <Setter Target="PART_PauseButton.Visibility" Value="Collapsed" />
                    <Setter Target="PART_CompactPauseButton.Visibility" Value="Collapsed" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="Regular" />
                <VisualState x:Name="Compact">
                  <VisualState.Setters>
                    <Setter Target="Card.Padding" Value="16,16,16,16" />
                    <Setter Target="HeaderControls.Visibility" Value="Collapsed" />
                    <Setter Target="DeltaText.Visibility" Value="Collapsed" />
                    <Setter Target="ValueText.FontSize" Value="40" />
                    <Setter Target="RegularStats.Visibility" Value="Collapsed" />
                    <Setter Target="CompactStats.Visibility" Value="Visible" />
                    <Setter Target="CompactControls.Visibility" Value="Visible" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid RowSpacing="14">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <!-- Header: title, value with unit and change; status chip, window selector, pause. -->
              <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" VerticalAlignment="Bottom">
                  <TextBlock Text="{TemplateBinding Title}"
                             FontFamily="{StaticResource UiRegularFontFamily}"
                             FontSize="13"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}"
                             TextTrimming="CharacterEllipsis" />
                  <StackPanel x:Name="ValueRow" Orientation="Horizontal" Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock x:Name="ValueText"
                                 Text="{TemplateBinding ValueText}"
                                 FontFamily="{StaticResource UiSemiBoldFontFamily}"
                                 FontSize="44"
                                 LineHeight="44"
                                 LineStackingStrategy="BlockLineHeight"
                                 Foreground="{TemplateBinding Foreground}"
                                 AutomationProperties.LiveSetting="Off" />
                      <TextBlock Text="{TemplateBinding Unit}"
                                 FontFamily="{StaticResource UiMediumFontFamily}"
                                 FontSize="16"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,1"
                                 Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="DeltaText"
                               Text="{TemplateBinding DeltaText}"
                               FontFamily="{StaticResource MonoRegularFontFamily}"
                               FontSize="13"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,3"
                               Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                  </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <Border Height="30" Padding="12,0" CornerRadius="15" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{TemplateBinding AccentBrush}" StrokeThickness="1.5" VerticalAlignment="Center" />
                      <TextBlock x:Name="StatusLabel"
                                 Text="{TemplateBinding StatusText}"
                                 FontFamily="{StaticResource UiMediumFontFamily}"
                                 FontSize="13"
                                 VerticalAlignment="Center"
                                 Foreground="{TemplateBinding Foreground}"
                                 AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                  </Border>

                  <Button x:Name="PART_ReconnectButton"
                          Visibility="Collapsed"
                          Height="28"
                          Padding="10,0"
                          CornerRadius="14"
                          Style="{StaticResource LivelineOutlineButtonStyle}"
                          AutomationProperties.Name="Reconnect">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Viewbox Width="14" Height="14">
                        <Path Width="24" Height="24"
                              Data="M20,11 A8.1,8.1 0 0 0 4.5,9 M4,5 L4,9 L8,9 M4,13 A8.1,8.1 0 0 0 19.5,15 M20,19 L20,15 L16,15"
                              Stroke="{ThemeResource OnSurfaceBrush}" StrokeThickness="1.75"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                      </Viewbox>
                      <TextBlock Text="Reconnect" VerticalAlignment="Center" FontFamily="{StaticResource UiMediumFontFamily}" FontSize="12" />
                    </StackPanel>
                  </Button>

                  <StackPanel x:Name="HeaderControls" Orientation="Horizontal" Spacing="12">
                    <!-- Inside height 36 - 2 x 1 border - 2 x 2 padding = 30 >= the segments' 28 px MinHeight;
                         with 4 px padding it was 26, and the 1m / 5m / 15m labels lost their bottom 2 px. -->
                    <!-- xaml-lint: allow radius - half the 36 px height makes the pill; RadiusFull renders an oval on Skia -->
                    <Border Height="36" Padding="{StaticResource Space025Thickness}" CornerRadius="18" BorderThickness="1" BorderBrush="{ThemeResource OutlineBrush}">
                      <StackPanel Orientation="Horizontal" Spacing="2">
                        <RadioButton x:Name="PART_Window1" Content="1m" GroupName="LivelineWindow" Style="{StaticResource LivelineSegmentStyle}" AutomationProperties.Name="1 minute window" />
                        <RadioButton x:Name="PART_Window5" Content="5m" GroupName="LivelineWindow" Style="{StaticResource LivelineSegmentStyle}" AutomationProperties.Name="5 minute window" />
                        <RadioButton x:Name="PART_Window15" Content="15m" GroupName="LivelineWindow" Style="{StaticResource LivelineSegmentStyle}" AutomationProperties.Name="15 minute window" />
                      </StackPanel>
                    </Border>
                    <Button x:Name="PART_PauseButton"
                            Width="36" Height="36" CornerRadius="18"
                            Style="{StaticResource LivelineOutlineButtonStyle}"
                            AutomationProperties.Name="Pause stream">
                      <Grid>
                        <Viewbox x:Name="PauseIcon" Width="16" Height="16">
                          <Path Width="24" Height="24" Data="M6,5 L10,5 L10,19 L6,19 Z M14,5 L18,5 L18,19 L14,19 Z"
                                Stroke="{ThemeResource OnSurfaceBrush}" StrokeThickness="1.75" StrokeLineJoin="Round" />
                        </Viewbox>
                        <Viewbox x:Name="PlayIcon" Width="16" Height="16" Visibility="Collapsed" Margin="2,0,0,0">
                          <Path Width="24" Height="24" Data="M7,4 L7,20 L20,12 Z"
                                Stroke="{ThemeResource OnSurfaceBrush}" StrokeThickness="1.75" StrokeLineJoin="Round" />
                        </Viewbox>
                      </Grid>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Grid>

              <!-- The plot: focusable for ← → inspection (Home/End jump, Esc closes); hover inspects too. -->
              <ContentControl x:Name="PART_Plot"
                              Grid.Row="1"
                              MinHeight="160"
                              IsTabStop="True"
                              UseSystemFocusVisuals="True"
                              FocusVisualPrimaryBrush="{ThemeResource OnSurfaceBrush}"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch"
                              AutomationProperties.Name="Chart. Use left and right arrows to read points, Escape to close.">
                <local:LivelineChartCanvas x:Name="PART_Canvas" Background="Transparent" />
              </ContentControl>

              <!-- Window statistics. -->
              <Border Grid.Row="2" Padding="0,12,0,0" BorderThickness="0,1,0,0" BorderBrush="{TemplateBinding BorderBrush}">
                <Grid>
                  <StackPanel x:Name="RegularStats" Orientation="Horizontal" Spacing="32">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Min" Style="{StaticResource LivelineStatLabelStyle}" />
                      <TextBlock Text="{TemplateBinding MinText}" Style="{StaticResource LivelineStatValueStyle}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                      <TextBlock Text="Avg" Style="{StaticResource LivelineStatLabelStyle}" />
                      <TextBlock Text="{TemplateBinding AvgText}" Style="{StaticResource LivelineStatValueStyle}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                      <TextBlock Text="Max" Style="{StaticResource LivelineStatLabelStyle}" />
                      <TextBlock Text="{TemplateBinding MaxText}" Style="{StaticResource LivelineStatValueStyle}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                      <TextBlock Text="Window" Style="{StaticResource LivelineStatLabelStyle}" />
                      <TextBlock Text="{TemplateBinding WindowText}" Style="{StaticResource LivelineStatValueStyle}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                      <TextBlock Text="Samples" Style="{StaticResource LivelineStatLabelStyle}" />
                      <TextBlock Text="{TemplateBinding SamplesText}" Style="{StaticResource LivelineStatValueStyle}" />
                    </StackPanel>
                  </StackPanel>
                  <Grid x:Name="CompactStats" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" HorizontalAlignment="Left">
                      <TextBlock Text="Min" Style="{StaticResource LivelineStatLabelStyle}" />
                      <TextBlock Text="{TemplateBinding MinText}" Style="{StaticResource LivelineStatValueStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Center">
                      <TextBlock Text="Avg" Style="{StaticResource LivelineStatLabelStyle}" />
                      <TextBlock Text="{TemplateBinding AvgText}" Style="{StaticResource LivelineStatValueStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right">
                      <TextBlock Text="Max" Style="{StaticResource LivelineStatLabelStyle}" />
                      <TextBlock Text="{TemplateBinding MaxText}" Style="{StaticResource LivelineStatValueStyle}" />
                    </StackPanel>
                  </Grid>
                </Grid>
              </Border>

              <!-- Compact: the controls move under the chart, at touch size (40 px segments, 48 px pause). -->
              <Grid x:Name="CompactControls" Grid.Row="3" ColumnSpacing="10" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Padding="4" CornerRadius="24" BorderThickness="1" BorderBrush="{ThemeResource OutlineBrush}">
                  <Grid ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="PART_CompactWindow1" Content="1m" GroupName="LivelineCompactWindow" Height="40" CornerRadius="20" FontSize="14" Style="{StaticResource LivelineSegmentStyle}" AutomationProperties.Name="1 minute window" />
                    <RadioButton x:Name="PART_CompactWindow5" Grid.Column="1" Content="5m" GroupName="LivelineCompactWindow" Height="40" CornerRadius="20" FontSize="14" Style="{StaticResource LivelineSegmentStyle}" AutomationProperties.Name="5 minute window" />
                    <RadioButton x:Name="PART_CompactWindow15" Grid.Column="2" Content="15m" GroupName="LivelineCompactWindow" Height="40" CornerRadius="20" FontSize="14" Style="{StaticResource LivelineSegmentStyle}" AutomationProperties.Name="15 minute window" />
                  </Grid>
                </Border>
                <Button x:Name="PART_CompactPauseButton"
                        Grid.Column="1"
                        Width="48" Height="48" CornerRadius="24"
                        Style="{StaticResource LivelineOutlineButtonStyle}"
                        AutomationProperties.Name="Pause stream">
                  <Grid>
                    <Viewbox x:Name="CompactPauseIcon" Width="18" Height="18">
                      <Path Width="24" Height="24" Data="M6,5 L10,5 L10,19 L6,19 Z M14,5 L18,5 L18,19 L14,19 Z"
                            Stroke="{ThemeResource OnSurfaceBrush}" StrokeThickness="1.75" StrokeLineJoin="Round" />
                    </Viewbox>
                    <Viewbox x:Name="CompactPlayIcon" Width="18" Height="18" Visibility="Collapsed" Margin="2,0,0,0">
                      <Path Width="24" Height="24" Data="M7,4 L7,20 L20,12 Z"
                            Stroke="{ThemeResource OnSurfaceBrush}" StrokeThickness="1.75" StrokeLineJoin="Round" />
                    </Viewbox>
                  </Grid>
                </Button>
              </Grid>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
