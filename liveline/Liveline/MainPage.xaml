<Page x:Class="Liveline.Demo.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:liveline="using:Liveline"
      xmlns:ut="using:Uno.Themes"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">

  <!-- A minimal host: the card on a simulated feed, a switch to drop the connection, and the theme switch. -->
  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal"
                Spacing="8"
                HorizontalAlignment="Right"
                Margin="{utu:Responsive Narrowest='16,8', Normal='32,16'}">
      <!-- Checked = the connection is dropped. The checked label says what the next click does ("Reconnect"), and
           the checked state is filled (secondary container) so the switch stays visible: with the style's default
           checked brushes the label disappeared in both themes. -->
      <ToggleButton x:Name="ConnectionToggle"
                    Content="Drop connection"
                    Style="{StaticResource TextToggleButtonStyle}"
                    Click="OnConnectionToggleClick"
                    AutomationProperties.AutomationId="ConnectionToggle">
        <ut:ControlExtensions.AlternateContent>
          <TextBlock Text="Reconnect" />
        </ut:ControlExtensions.AlternateContent>
        <ToggleButton.Resources>
          <StaticResource x:Key="TextToggleButtonBackgroundChecked" ResourceKey="SecondaryContainerBrush" />
          <StaticResource x:Key="TextToggleButtonBackgroundCheckedPointerOver" ResourceKey="SecondaryContainerBrush" />
          <StaticResource x:Key="TextToggleButtonBackgroundCheckedPressed" ResourceKey="SecondaryContainerBrush" />
          <StaticResource x:Key="TextToggleButtonForegroundChecked" ResourceKey="OnSecondaryContainerBrush" />
          <StaticResource x:Key="TextToggleButtonForegroundCheckedPointerOver" ResourceKey="OnSecondaryContainerBrush" />
          <StaticResource x:Key="TextToggleButtonForegroundCheckedPressed" ResourceKey="OnSecondaryContainerBrush" />
        </ToggleButton.Resources>
      </ToggleButton>
      <ToggleButton x:Name="ThemeToggle"
                    Style="{StaticResource IconToggleButtonStyle}"
                    AutomationProperties.Name="Dark theme"
                    ToolTipService.ToolTip="Dark theme"
                    Loaded="OnThemeToggleLoaded"
                    Click="OnThemeToggleClick">
        <ut:ControlExtensions.AlternateContent>
          <FontIcon Glyph="&#xE708;" />
        </ut:ControlExtensions.AlternateContent>
        <FontIcon Glyph="&#xE708;" />
      </ToggleButton>
    </StackPanel>

    <liveline:LivelineChart x:Name="Chart"
                            Grid.Row="1"
                            Title="API latency · p95"
                            Unit="ms"
                            AxisMinimum="40"
                            AxisMaximum="70"
                            AxisStep="10"
                            AlertThreshold="65"
                            AlertLabel="Alert above 65"
                            MaxWidth="992"
                            Height="{utu:Responsive Narrowest=640, Normal=522}"
                            Margin="{utu:Responsive Narrowest='16,0,16,16', Normal='32,0,32,32'}"
                            VerticalAlignment="{utu:Responsive Narrowest=Stretch, Normal=Center}"
                            AutomationProperties.Name="API latency, live" />
  </Grid>
</Page>
